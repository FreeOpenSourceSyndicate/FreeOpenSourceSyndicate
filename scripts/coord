#!/usr/bin/env python3
# AI/LLM-generated file. Do not treat as human-written source documentation.
"""coord - a git-native task lease ledger for a fleet of parallel AI agents.

The whole coordination state lives in **git refs** on the shared remote
(``refs/coord/leases/<area>``).  A ref update is an atomic
compare-and-swap, so a lease is taken without a lock server, a database, or any
long-lived process.  Every lease carries a TTL; a lease whose TTL has passed is
*expired* and may be taken over by anyone.  Because the fleet may pause an agent
for an unbounded time (crash, dropped connection, a run that never resumes), the
system never waits on a lease holder: it either works on something else or
reclaims the lease after the TTL.

Commands
--------
``claim``    take a lease (fails if a live one exists, unless ``--takeover``)
``renew``    extend a lease you hold
``release``  give a lease up early
``status``   print the whole ledger
``check``    assert no two live leases collide; used as a CI gate
``board``    render the generated coordination board (docs/COORDINATION_BOARD.md)
``sweep``    delete expired refs, sync issue labels/claims, rebuild the board
``migrate``  import the legacy CLAIM:/LEASE: comments into the ledger (one-off)

Ref layout (one ref per **area** - the lock is the area, so the CAS target must
be the area too; see the "one lock per claim" note below):

    refs/coord/leases/<area>

The ref *target* is an empty commit whose message is a single JSON object::

    {"agent": "...", "area": "world", "issue": 157, "branch": "...",
     "state": "claimed", "epoch": 1792050687, "ttl": 21600, "note": ""}

Design notes
------------
* **One lock per claim, and the lock is the area.**  A file has exactly one
  owning focus area, so two agents collide only by holding the same area.  The
  CAS target must therefore be the *area* ref, not the issue ref: if the lock
  were keyed by issue, two agents claiming different issues in the same area at
  the same instant would each CAS a different ref and both win.  Keying the ref
  by area makes the single ``push --force-with-lease`` decide the whole area.
  Claiming several areas at once is supported by pushing all of those refs in one
  atomic ``--atomic`` push (all-or-nothing), with the refs ordered so concurrent
  multi-area claims cannot deadlock.
* **TTL, not a heartbeat.**  Renewal is cheap (one ref update); a stale holder
  cannot block the fleet for more than the TTL.
* **Expiry is mechanical.**  Nobody adjudicates.  ``sweep`` deletes expired
  refs; the next ``claim`` simply succeeds.
* **The board is generated.**  It is a *view*; it can never drift from the
  ledger and never needs a hand-written "refresh the queue" PR.

Only the Python standard library and a ``git`` binary are required.
"""

from __future__ import annotations

import argparse
import json
import os
import re
import shlex
import socket
import subprocess
import sys
import time
from dataclasses import dataclass, field
from datetime import datetime
from typing import Iterable, Optional

# --------------------------------------------------------------------------- #
# Configuration
# --------------------------------------------------------------------------- #

DEFAULT_TTL = 6 * 60 * 60          # 6 h: a normal work cycle.
MAX_TTL = 24 * 60 * 60             # never hold an area longer than a day.
# A live lease not renewed for this long is *stale*: the holder may still be
# working, but a --takeover is fair game.  This must stay below DEFAULT_TTL,
# otherwise a lease expires before it can ever be flagged stale and the signal
# is dead code (guarded by tests/test_coord.py).
#
# Lowered 3h -> 2h after the Kastenbrot/Gnampf takeover review: a work cycle is
# short, and a holder quiet for 2h is more likely gone than thinking.  The SM
# watches run lengths and takeover outcomes and tunes this (docs/COORDINATION.md
# section 6a): raise it if false takeovers of active agents appear, lower it if
# genuine stragglers sit too long.  `COORD_STALE_AFTER` overrides it at runtime.
STALE_AFTER = int(os.environ.get("COORD_STALE_AFTER") or 2 * 60 * 60)  # 2 h
REF_PREFIX = "refs/coord/leases"

# Focus areas are DATA, not code: docs/focus-areas.json lists them (plus a
# 2-letter role code and the critical-path flag), so the Product Owner can
# redesign the area set without a Python change (docs/ORGANISATION.md section 9).
# The constants below are the fallback used when that file is missing or
# unreadable, so coordination never breaks on a bad edit.
FOCUS_AREAS_PATH = "docs/focus-areas.json"
_DEFAULT_AREAS = {
    "tactical": {"code": "ta", "label": "Tactical / Mission"},
    "world": {"code": "wo", "label": "World / Simulation"},
    "render": {"code": "re", "label": "Render / Engine"},
    "input-ui": {"code": "ui", "label": "Input / UI / UX"},
    "content": {"code": "co", "label": "Content / Data"},
    "text": {"code": "tx", "label": "Text / i18n / Lore"},
    "metagame": {"code": "mg", "label": "Metagame / Campaign"},
    "platform": {"code": "pf", "label": "Build / CI / Tooling"},
    "rules": {"code": "ru", "label": "Rules / Process"},
    "release": {"code": "rl", "label": "Release / Playtest"},
}
# The Scrum Master's ONE lane: the process docs themselves (`rules`).  The SM is
# a process role that organises the fleet, so its only focus area is the
# coordination rules; everything that makes or ships the game - including
# `platform` (build/CI/scripts/packaging) - is a normal WORKER lane.  The SM is
# never routed to game or build work: `coord next` offers an SM only an
# sm_owned area, and falls through to its durable jobs (drain the merge queue,
# review) when that lane is held (ADR-0041, human directive 2026-10-17).
_DEFAULT_SM_OWNED = ("rules",)
# Critical-path order (docs/ROADMAP.md).  `coord next` prefers these so an idle
# agent is steered at the work that unblocks the release, not just any free area.
# The long pole comes first.  Redefined for Milestone C by the PO (2026-10-17,
# issue #425): the mission set (tactical) is now the long pole because the map
# content (#418) and the content guard (#420) are both blocked-by it; metagame
# and world follow.  `platform`/`render`/`release` stay off the list - they do
# delivery, not features, and must not absorb capacity from the feature lanes.
_DEFAULT_CRITICAL = ("tactical", "metagame", "world")
# Process roles (no focus area).  A role code names an agent: <role>-<n>-<host>.
_DEFAULT_ROLES = {
    "sm": {"code": "sm", "label": "Scrum master", "focus": None},
    "po": {"code": "po", "label": "Product owner", "focus": None},
}
_DEFAULT_CHANNELS = {
    "sm": "Scrum master <-> scrum master handoff (one SM per computer).",
    "po": "Product owner <-> product owner handoff (one PO per computer).",
    "takeover": "Takeover requests: a live agent asks the fleet to take over an "
                "area whose holder has gone quiet.",
}


@dataclass(frozen=True)
class FocusConfig:
    """The focus-area + role + channel set, loaded from docs/focus-areas.json.

    Kept as one object so a redesign is a single atomic reload rather than a
    scatter of module globals (the tests patch ``coord.CONFIG``).
    """
    areas: dict
    roles: dict
    channels: dict
    critical: tuple = ()
    sm_owned: tuple = ()

    @property
    def area_names(self) -> tuple:
        return tuple(self.areas)

    @property
    def worker_areas(self) -> tuple:
        """Areas a plain worker may be routed to (the SM-owned ones removed)."""
        return tuple(a for a in self.areas if a not in self.sm_owned)

    def sm_owns(self, area: str) -> bool:
        return area in self.sm_owned

    @property
    def critical_path_areas(self) -> tuple:
        """Critical-path areas, in the file's priority order, then the rest.

        The ``critical_path`` list preserves the *order* (metagame before
        tactical, so the long pole is picked first); any area marked
        ``critical: true`` in its own spec is appended in area order, for a
        redesign that prefers the per-area flag.
        """
        ordered = [a for a in self.critical if a in self.areas]
        for name, spec in self.areas.items():
            if spec.get("critical") and name not in ordered:
                ordered.append(name)
        return tuple(ordered)

    def code_for(self, name: str) -> str:
        """The 2-letter role code for an area, or '' if unknown."""
        spec = self.areas.get(name) or self.roles.get(name)
        return (spec or {}).get("code", "") or ("" if not spec else name[:2])

    def name_for_code(self, code: str) -> Optional[str]:
        for name, spec in {**self.areas, **self.roles}.items():
            if spec.get("code") == code:
                return name
        return None


def load_focus_config(path: Optional[str] = None) -> FocusConfig:
    """Load docs/focus-areas.json, falling back to the built-in default set.

    A missing or malformed file is never fatal: coordination must keep working
    on a bad edit (a broken rules file would otherwise stall the whole fleet).
    The environment variable ``COORD_FOCUS_AREAS`` overrides the path (tests).
    """
    path = path or os.environ.get("COORD_FOCUS_AREAS") or FOCUS_AREAS_PATH
    areas = dict(_DEFAULT_AREAS)
    roles = dict(_DEFAULT_ROLES)
    channels = dict(_DEFAULT_CHANNELS)
    critical = _DEFAULT_CRITICAL
    sm_owned = _DEFAULT_SM_OWNED
    try:
        with open(path, encoding="utf-8") as fh:
            data = json.load(fh)
    except (OSError, json.JSONDecodeError, ValueError):
        return FocusConfig(areas=areas, roles=roles, channels=channels,
                           critical=critical, sm_owned=sm_owned)
    if isinstance(data.get("areas"), dict) and data["areas"]:
        areas = {str(k): dict(v or {}) for k, v in data["areas"].items()}
    if isinstance(data.get("roles"), dict) and data["roles"]:
        roles = {str(k): dict(v or {}) for k, v in data["roles"].items()}
    if isinstance(data.get("channels"), dict) and data["channels"]:
        channels = {str(k): str(v) for k, v in data["channels"].items()}
    if isinstance(data.get("critical_path"), list):
        critical = tuple(str(a) for a in data["critical_path"])
    if isinstance(data.get("sm_owned"), list):
        # Only keep names that are real areas: a stale entry must not silently
        # hide nothing (or, worse, a typo'd area from every worker's routing).
        sm_owned = tuple(str(a) for a in data["sm_owned"] if str(a) in areas)
    return FocusConfig(areas=areas, roles=roles, channels=channels,
                       critical=critical, sm_owned=sm_owned)


CONFIG = load_focus_config()
AREAS = CONFIG.area_names
SM_OWNED_AREAS = CONFIG.sm_owned
WORKER_AREAS = CONFIG.worker_areas
CRITICAL_PATH_AREAS = CONFIG.critical_path_areas
ROLES = tuple(CONFIG.roles)
CHANNELS = tuple(CONFIG.channels)

BOARD_PATH = "docs/COORDINATION_BOARD.md"
BOARD_MARKER = "<!-- coord:board -->"

# The board is published by committing on top of `main` and pushing non-forced.
# The scheduled sweep checks out `main` at run start, so any PR merged while the
# sweep ran makes that push a non-fast-forward; it is retried on the fresh main
# rather than forced, so a concurrent merge is never discarded (issue #381).
BOARD_BRANCH = "main"
BOARD_COMMIT_MSG = "chore(coord): regenerate the coordination board [skip ci]"
BOARD_PUSH_ATTEMPTS = 3

# The well-known empty tree id, so ledger/note commits need no mktree stdin.
_EMPTY_TREE = "4b825dc642cb6eb9a060e54bf8d69288fbee4904"

# (CRITICAL_PATH_AREAS is derived from docs/focus-areas.json above.)

# Unchecked roadmap items are the backlog seed when nothing is claimable.
ROADMAP_PATH = "docs/ROADMAP.md"

# Roster + agent-name conventions (docs/ORGANISATION.md sections 3-4).  An agent is
# named <role>-<n>-<host>; the roster is one ref per host so the Product Owner
# sees only its own computer's agents (a PO can only request agents on its host).
ROSTER_PREFIX = "refs/coord/roster"
# <role> is a code (no hyphen), <n> is digits, <host> may carry hyphens/dots.
AGENT_NAME_RE = re.compile(
    r"^(?P<role>[a-z0-9]+)-(?P<n>\d+)-(?P<host>[a-z0-9][a-z0-9.-]*)$")
# The daily new-agent budget is SHARED across all computers and other projects
# (the human's chat limit).  It is tracked per host as a *local* estimate only;
# the human is the authority.  No hard cap is enforced here.
DEFAULT_BUDGET_CAP = 10

# A green, non-draft PR that has waited this long is *drainable*: merging it is
# finished work one step from landing (near-zero marginal cost), so `next` offers
# it ahead of *claiming* new work.  The floor stops an agent from abandoning its
# own claim the instant a peer opens a PR; critical-path work still goes first.
MERGE_DRAIN_MIN_AGE = 30 * 60

# The legacy protocol, still accepted on read so a claim posted by an old agent
# mid-migration is honoured.  See docs/COORDINATION_MIGRATION.md.
LEGACY_CLAIM_RE = re.compile(r"^\s*CLAIM:\s*(?P<agent>[^|]+)\|\s*(?P<area>[^|]+)\|", re.M)
LEGACY_LEASE_RE = re.compile(r"^\s*LEASE:\s*(?P<agent>[^|]+)\|\s*(?P<branch>[^|]+?)\s*\|", re.M)
LEGACY_TAKEOVER_RE = re.compile(r"^\s*TAKEOVER:\s*(?P<agent>[^|]+)\|\s*(?P<area>[^|]+)", re.M)

# A cross-area block is declared machine-readably in the dependent issue's body
# as `blocked-by: #<n>` (docs/COORDINATION.md §3, ADR-0030).  The sweep clears
# `status: blocked` once every referenced issue is closed, so a block lifts
# itself instead of waiting for an agent to remember (issue #326).  Several
# numbers may share one line (`blocked-by: #311, #312`).
BLOCKED_BY_RE = re.compile(r"blocked-by:\s*(?P<refs>#[0-9]+(?:\s*,\s*#[0-9]+)*)",
                           re.IGNORECASE)
ISSUE_REF_RE = re.compile(r"#([0-9]+)")


# --------------------------------------------------------------------------- #
# Small helpers
# --------------------------------------------------------------------------- #

class CoordError(RuntimeError):
    """A recoverable, user-facing coordination error."""


class CoordAuthError(CoordError):
    """A push failed because the remote rejected our credentials.

    Distinct from a lost CAS race: the ledger did *not* move, we simply could
    not talk to it.  Reporting it as a race sends the caller to re-read state
    that is unchanged, so it is raised (and re-raised) verbatim.
    """


# Substrings git emits when a push is rejected for authentication/credentials
# rather than a non-fast-forward.  Kept lowercase for a casefolded match.
_AUTH_FAILURE_MARKERS = (
    "authentication failed",
    "could not read username",
    "could not read password",
    "terminal prompts disabled",
    "invalid username or password",
    "support for password authentication was removed",
    "permission denied (publickey)",
    "403 forbidden",
    "401 unauthorized",
)


def _push_hint(detail: str) -> Optional[str]:
    """An actionable hint if ``detail`` is a credential failure, else None."""
    low = (detail or "").lower()
    if not any(marker in low for marker in _AUTH_FAILURE_MARKERS):
        return None
    return (
        "the remote rejected your git credentials (not a lease race - the ledger "
        "did not move). Fix push auth, then re-run: `gh auth setup-git` installs "
        "a credential helper for github.com; a stale token embedded in the "
        "remote URL is the usual cause - check `git remote -v`."
    )


def now() -> int:
    """Current POSIX time.  Patchable in tests via ``COORD_NOW``."""
    override = os.environ.get("COORD_NOW")
    if override:
        return int(override)
    return int(time.time())


def iso(epoch: int) -> str:
    return time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime(epoch))


def human_delta(seconds: int) -> str:
    seconds = int(seconds)
    sign = "-" if seconds < 0 else ""
    seconds = abs(seconds)
    for unit, size in (("d", 86400), ("h", 3600), ("m", 60)):
        if seconds >= size:
            return f"{sign}{seconds // size}{unit}"
    return f"{sign}{seconds}s"


def parse_duration(text: str) -> int:
    """Parse ``90``, ``90m``, ``6h``, ``2d`` (or ``30s``) into seconds."""
    text = str(text).strip()
    m = re.fullmatch(r"(\d+)\s*([smhd]?)", text)
    if not m:
        raise CoordError(f"cannot parse duration: {text!r}")
    value, unit = int(m.group(1)), m.group(2)
    return value * {"": 60, "s": 1, "m": 60, "h": 3600, "d": 86400}[unit]


def _run(args: list[str], *, check: bool = True, capture: bool = True,
         cwd: Optional[str] = None, env: Optional[dict] = None) -> subprocess.CompletedProcess:
    proc = subprocess.run(
        args,
        cwd=cwd,
        env=env,
        check=False,
        text=True,
        stdout=subprocess.PIPE if capture else None,
        stderr=subprocess.PIPE if capture else None,
    )
    if check and proc.returncode != 0:
        detail = (proc.stderr or proc.stdout or "").strip()
        raise CoordError(f"command failed ({' '.join(args)}): {detail}")
    return proc


def git(*args: str, check: bool = True, cwd: Optional[str] = None,
        env: Optional[dict] = None) -> subprocess.CompletedProcess:
    return _run(["git", *args], check=check, cwd=cwd, env=env)


def gh(*args: str, check: bool = True) -> subprocess.CompletedProcess:
    return _run(["gh", *args], check=check)


# --------------------------------------------------------------------------- #
# The ledger
# --------------------------------------------------------------------------- #

@dataclass
class Lease:
    agent: str
    area: str
    issue: int
    branch: str = ""
    state: str = "claimed"          # claimed | blocked | needs-review
    epoch: int = 0
    ttl: int = DEFAULT_TTL
    note: str = ""

    @property
    def expires(self) -> int:
        return self.epoch + self.ttl

    def is_live(self, at: Optional[int] = None) -> bool:
        return (at if at is not None else now()) < self.expires

    def is_stale(self, at: Optional[int] = None) -> bool:
        at = at if at is not None else now()
        return self.is_live(at) and at - self.epoch > STALE_AFTER

    def age(self, at: Optional[int] = None) -> int:
        return (at if at is not None else now()) - self.epoch

    def to_json(self) -> str:
        return json.dumps(
            {
                "agent": self.agent,
                "area": self.area,
                "issue": self.issue,
                "branch": self.branch,
                "state": self.state,
                "epoch": self.epoch,
                "ttl": self.ttl,
                "note": self.note,
            },
            sort_keys=True,
        )

    @classmethod
    def from_message(cls, message: str) -> "Lease":
        data = json.loads(message)
        return cls(
            agent=data["agent"],
            area=data["area"],
            issue=int(data["issue"]),
            branch=data.get("branch", ""),
            state=data.get("state", "claimed"),
            epoch=int(data.get("epoch", 0)),
            ttl=int(data.get("ttl", DEFAULT_TTL)),
            note=data.get("note", ""),
        )


def ref_for(area: str) -> str:
    """The lease ref for an area.  The **area is the lock**, so the ref is keyed
    by area alone - see the "one lock per claim" design note."""
    return f"{REF_PREFIX}/{area}"


def read_lease(ref: str, cwd: Optional[str] = None) -> Optional[Lease]:
    """Return the lease at ``ref``, or None if it is missing/undecodable."""
    proc = git("log", "-1", "--format=%B", ref, check=False, cwd=cwd)
    if proc.returncode != 0:
        return None
    body = (proc.stdout or "").strip()
    if not body:
        return None
    try:
        return Lease.from_message(body)
    except (ValueError, KeyError, json.JSONDecodeError):
        return None


def list_refs(cwd: Optional[str] = None) -> list[str]:
    proc = git("for-each-ref", "--format=%(refname)", f"{REF_PREFIX}/", check=False, cwd=cwd)
    if proc.returncode != 0:
        return []
    return [line.strip() for line in (proc.stdout or "").splitlines() if line.strip()]


def list_leases(cwd: Optional[str] = None) -> list[Lease]:
    leases = []
    for ref in list_refs(cwd):
        lease = read_lease(ref, cwd)
        if lease is not None:
            leases.append(lease)
    return leases


def fetch_ledger(cwd: Optional[str] = None, *, required: bool = False) -> None:
    """Refresh the remote lease refs into the local namespace.

    A fetch that matches no refs is a success (a fresh ledger), so an empty
    result is never an error.  But a fetch that *fails* leaves the local
    namespace holding whatever it held before - possibly nothing - and callers
    that read the ledger to decide something (does this area have a holder? what
    is live?) would then act on a stale or empty view.  ``required=True`` makes
    that failure fatal: ``CoordAuthError`` for a credential rejection, else
    ``CoordError``.  The best-effort default keeps ``fetch_notes``-style
    refreshes (and reads that only display) tolerant.
    """
    proc = git("fetch", "--prune", "--force", "origin",
               f"+{REF_PREFIX}/*:{REF_PREFIX}/*", check=False, cwd=cwd)
    if not required or proc.returncode == 0:
        return
    detail = (proc.stderr or proc.stdout or "").strip()
    hint = _push_hint(detail)
    if hint is not None:
        raise CoordAuthError(f"could not read the lease ledger: {hint}\n{detail}")
    raise CoordError(f"could not read the lease ledger:\n{detail}")


# --------------------------------------------------------------------------- #
# Notes - cross-cycle handoff that survives a lease release
# --------------------------------------------------------------------------- #
#
# A lease is scoped to *now*: it is deleted when it expires or is released, so a
# fact that the next cycle needs ("the push auth is broken", "do not re-claim
# epic #315, its scope landed") has nowhere to live.  Notes are that place.  They
# are the same git-native shape as the leases - one ref per area, a JSON body,
# no lock server - but they are *append-only* and never expire: the area ref is
# a running log, newest entry last, capped to the most recent ``MAX_NOTES``.

NOTE_PREFIX = "refs/coord/notes"
MAX_NOTES = 20


@dataclass
class Note:
    agent: str
    area: str
    text: str
    epoch: int = 0

    def to_json(self) -> str:
        return json.dumps({
            "agent": self.agent,
            "area": self.area,
            "text": self.text,
            "epoch": self.epoch,
        }, sort_keys=True)

    @classmethod
    def from_json(cls, body: str) -> "Note":
        data = json.loads(body)
        return cls(
            agent=data["agent"],
            area=data["area"],
            text=data["text"],
            epoch=int(data.get("epoch", 0)),
        )


def notes_ref_for(area: str) -> str:
    return f"{NOTE_PREFIX}/{area}"


def read_notes(area: str, cwd: Optional[str] = None) -> list[Note]:
    """All notes for an area, oldest first.  Missing/corrupt ref -> []."""
    proc = git("log", "--reverse", "--format=%B%x00", notes_ref_for(area),
               check=False, cwd=cwd)
    if proc.returncode != 0:
        return []
    notes = []
    for body in (proc.stdout or "").split("\x00"):
        body = body.strip()
        if not body:
            continue
        try:
            notes.append(Note.from_json(body))
        except (ValueError, KeyError, json.JSONDecodeError):
            continue
    return notes


def list_all_notes(cwd: Optional[str] = None) -> dict[str, list[Note]]:
    """Every topic's notes, keyed by topic, oldest first.

    Topics are the focus areas *plus* the named channels (`sm`, `po`,
    `takeover`), so the process roles get a durable log of their own that is
    neither a focus area nor a lock (docs/ORGANISATION.md section 5).
    """
    result: dict[str, list[Note]] = {}
    for topic in tuple(AREAS) + tuple(CHANNELS):
        notes = read_notes(topic, cwd=cwd)
        if notes:
            result[topic] = notes
    return result


def _notes_push(area: str, head: str, expect: Optional[str], *,
                cwd: Optional[str] = None) -> None:
    """Publish the rebuilt note chain, refusing to clobber a concurrent append.

    ``expect`` is the remote value the caller built its replacement on.  A
    plain ``--force`` never conflicts, so it silently overwrites a note another
    clone pushed meanwhile (a lost update).  The per-ref lease is the same
    compare-and-swap the lease refs use: ``None`` means "the ref must not exist
    yet" (create), a sha means "replace exactly that value".  A stale
    expectation is reported as an ordinary failure for the caller to re-read and
    retry; a credential failure is raised, since retrying cannot fix it.
    """
    _push_note_ref(notes_ref_for(area), head, expect, area, cwd=cwd)


def _push_note_ref(ref: str, head: str, expect: Optional[str], what: str, *,
                   cwd: Optional[str] = None) -> None:
    """Publish a rebuilt note/message chain under a compare-and-swap.

    Shared by the area notes log and the direct-message log: both are
    append-only chains rebuilt from the read value, so both need the same
    lost-update protection.
    """
    lease = f"--force-with-lease={ref}:{expect or ''}"
    proc = git("push", lease, "origin", f"{head}:{ref}",
               check=False, cwd=cwd, env=_git_env())
    if proc.returncode != 0:
        detail = (proc.stderr or proc.stdout or "").strip()
        hint = _push_hint(detail)
        if hint is not None:
            raise CoordAuthError(f"could not publish {what}: {hint}\n{detail}")
        raise CoordError(f"ref {ref} moved under us:\n{detail}")
    git("update-ref", ref, head, check=False, cwd=cwd)


def _write_note_ref(ref: str, notes: list[Note], expect: Optional[str] = None, *,
                    what: str = "notes", cwd: Optional[str] = None) -> None:
    """Replace a note/message ref with a fresh chain of the given entries.

    The ref is rebuilt as a linear history (one commit per entry) so the log is
    human-readable with `git log <ref>`, then published under a compare-and-swap
    on ``expect`` (see ``_push_note_ref``).  A lost race raises, and the caller
    re-reads and retries, so no append is dropped.
    """
    env = _git_env()
    parent: Optional[str] = None
    head: Optional[str] = None
    for note in notes[-MAX_NOTES:]:
        args = ["commit-tree", _EMPTY_TREE, "-m", note.to_json()]
        if parent:
            args += ["-p", parent]
        commit = _run(["git", *args], cwd=cwd, env=env).stdout.strip()
        parent = commit
        head = commit
    if head is None:
        return
    _push_note_ref(ref, head, expect, what, cwd=cwd)


def _write_notes(area: str, notes: list[Note], *, cwd: Optional[str] = None,
                 expect: Optional[str] = None) -> None:
    """Replace an area's note ref with a fresh chain of the given notes.

    A thin wrapper over ``_write_note_ref`` that keeps the area-notes call
    sites unchanged.
    """
    _write_note_ref(notes_ref_for(area), notes, expect,
                    what=f"notes for {area}", cwd=cwd)


def fetch_notes(cwd: Optional[str] = None) -> None:
    """Best-effort refresh of the remote note refs into the local namespace."""
    git("fetch", "--prune", "--force", "origin",
        f"+{NOTE_PREFIX}/*:{NOTE_PREFIX}/*", check=False, cwd=cwd)


def append_note(area: str, agent: str, text: str, *, cwd: Optional[str] = None) -> Note:
    """Append a note for an area, preserving any concurrent appends.

    Read-modify-write against a log: re-read after a lost push and merge the
    entries, so two agents appending at once both keep their note.
    """
    note = Note(agent=agent, area=area, text=text, epoch=now())
    for _ in range(5):
        # Read the *remote* value first, then the notes themselves, and require
        # the remote ref to still hold that value at push time.  Comparing
        # against the remote (not a possibly-stale local mirror) is what makes
        # two clones appending at once merge instead of one clobbering the
        # other.
        fetch_notes(cwd=cwd)
        expect = _local_ref_sha(notes_ref_for(area), cwd=cwd)
        existing = read_notes(area, cwd=cwd)
        if any(n.agent == note.agent and n.text == note.text for n in existing):
            break
        merged = existing + [note]
        try:
            _write_notes(area, merged, cwd=cwd, expect=expect)
            return note
        except CoordAuthError:
            raise
        except CoordError:
            continue
    return note


# --------------------------------------------------------------------------- #
# Direct messages - agent-to-agent, after the initial prompt
# --------------------------------------------------------------------------- #
#
# The generated initial prompt is how a *new* agent is started; it is a one-off,
# delivered by the human because a chat that does not exist yet cannot read a
# ref.  Every exchange after that must not go back through the human: an agent
# that needs a fact from a peer, or the SM, addresses it directly.  A message is
# a note that names ONE recipient, kept at refs/coord/msg/<agent> - the same
# append-only, never-a-lock shape as the notes log, so it needs no server and
# survives a release.

MSG_PREFIX = "refs/coord/msg"


def msg_ref_for(agent: str) -> str:
    return f"{MSG_PREFIX}/{agent}"


def fetch_messages(cwd: Optional[str] = None) -> None:
    """Best-effort refresh of the remote message refs into the local namespace."""
    git("fetch", "--prune", "--force", "origin",
        f"+{MSG_PREFIX}/*:{MSG_PREFIX}/*", check=False, cwd=cwd)


def read_messages(agent: str, cwd: Optional[str] = None) -> list[Note]:
    """Messages addressed to one agent, oldest first.  Missing/corrupt -> []."""
    proc = git("log", "--reverse", "--format=%B%x00", msg_ref_for(agent),
               check=False, cwd=cwd)
    if proc.returncode != 0:
        return []
    messages = []
    for body in (proc.stdout or "").split("\x00"):
        body = body.strip()
        if not body:
            continue
        try:
            messages.append(Note.from_json(body))
        except (ValueError, KeyError, json.JSONDecodeError):
            continue
    return messages


def send_message(to: str, agent: str, text: str, *,
                 cwd: Optional[str] = None) -> Note:
    """Send a direct message to one named agent.

    The recipient must be a valid agent name: a message to a name nobody can
    read is worse than no message, so a typo fails fast rather than sitting in
    an unread ref.  The log is append-only and never expires, exactly like a
    note; ``coord inbox`` reads it.
    """
    parsed = parse_agent_name(to)
    if not parsed:
        raise CoordError(f"'{to}' is not a valid agent name "
                         f"(<role>-<n>-<host>, e.g. ta-1-kastenbrot).")
    message = Note(agent=agent, area=to, text=text, epoch=now())
    for _ in range(5):
        fetch_messages(cwd=cwd)
        expect = _local_ref_sha(msg_ref_for(to), cwd=cwd)
        existing = read_messages(to, cwd=cwd)
        if any(m.agent == message.agent and m.text == message.text
               for m in existing):
            break
        try:
            _write_note_ref(msg_ref_for(to), existing + [message], expect,
                            cwd=cwd)
            return message
        except CoordAuthError:
            raise
        except CoordError:
            continue
    return message


# --------------------------------------------------------------------------- #
# Roster + agent names (docs/ORGANISATION.md sections 3-4)
# --------------------------------------------------------------------------- #
#
# An agent is named "<role>-<n>-<host>" (e.g. ta-1-kastenbrot, sm-1-gnampf).  The
# role is a 2-letter focus-area code for a worker, or "sm"/"po" for the process
# roles.  The host makes the name globally unique in the shared repo, and the
# number is unique per (role, host) and NEVER reused: a replacement agent is a
# new entity with a new number (a worker starts with no memory of its
# predecessor, so it must not inherit the name).  See docs/focus-areas.json.
#
# The roster is one ref per host (refs/coord/roster/<host>), so the Product Owner
# of a computer sees only that computer's agents - a PO can only request agents
# on its own host.  The roster also carries a per-host *estimate* of the daily
# new-agent budget; the real limit is shared across computers and other projects
# and is enforced by the human, not here.

ROSTER_PREFIX = "refs/coord/roster"


HOST_RE = re.compile(r"^[a-z0-9][a-z0-9.-]*$")


def default_host() -> str:
    """This computer's host token: ``COORD_HOST`` if set, else ``hostname``.

    The host is what makes an agent name globally unique in the shared repo, so
    it must be stable per computer and not left to memory.  ``COORD_HOST`` wins
    (the human sets it to a friendly name like ``kastenbrot``); otherwise the
    machine's hostname is used, sanitised to the ref-safe token grammar.
    """
    raw = os.environ.get("COORD_HOST") or socket.gethostname() or ""
    token = re.sub(r"[^a-z0-9.-]+", "-", raw.strip().lower()).strip(".-")
    return token if valid_host(token) else "localhost"


def valid_host(host: str) -> bool:
    """A host is a lowercase token; it is used verbatim in a git ref name.

    Rejecting anything else (notably ``..`` and ``/``) keeps the roster ref well
    formed, so a bad ``--host`` cannot write outside ``refs/coord/roster/``.
    """
    host = (host or "").strip().lower()
    return bool(host) and bool(HOST_RE.match(host)) and ".." not in host


def parse_agent_name(name: str) -> Optional[dict]:
    """Split "<role>-<n>-<host>", or None if it is not that shape.

    Legacy bare model strings ("OpenHands", "Claude Sonnet 4.5") are *not*
    valid agent names; they are still accepted by the ledger for back-compat,
    but they carry no host and so are invisible to the roster.
    """
    m = AGENT_NAME_RE.match((name or "").strip().lower())
    if not m:
        return None
    return {"role": m.group("role"), "n": int(m.group("n")), "host": m.group("host")}


def agent_host(name: str) -> str:
    """The host part of an agent name, or '' for a legacy/bare name."""
    parsed = parse_agent_name(name)
    return parsed["host"] if parsed else ""


def roster_ref_for(host: str) -> str:
    return f"{ROSTER_PREFIX}/{host}"


@dataclass
class AgentEntry:
    name: str
    role: str
    model: str = ""
    status: str = "active"          # reserved | active | retired
    since: int = 0
    succeeded_by: str = ""
    note: str = ""

    def to_json(self) -> str:
        return json.dumps({
            "name": self.name, "role": self.role, "model": self.model,
            "status": self.status, "since": self.since,
            "succeeded_by": self.succeeded_by, "note": self.note,
        }, sort_keys=True)

    @classmethod
    def from_dict(cls, data: dict) -> "AgentEntry":
        return cls(
            name=data.get("name", ""), role=data.get("role", ""),
            model=data.get("model", ""), status=data.get("status", "active"),
            since=int(data.get("since", 0)),
            succeeded_by=data.get("succeeded_by", ""), note=data.get("note", ""),
        )


@dataclass
class Roster:
    host: str
    agents: list = field(default_factory=list)
    budget: dict = field(default_factory=dict)
    updated: int = 0

    def to_json(self) -> str:
        return json.dumps({
            "host": self.host,
            "agents": [json.loads(a.to_json()) if isinstance(a, AgentEntry) else a
                       for a in self.agents],
            "budget": self.budget,
            "updated": self.updated,
        }, sort_keys=True, indent=2)

    @classmethod
    def from_dict(cls, data: dict) -> "Roster":
        return cls(
            host=data.get("host", ""),
            agents=[AgentEntry.from_dict(a) for a in data.get("agents", [])],
            budget=dict(data.get("budget", {})),
            updated=int(data.get("updated", 0)),
        )

    def active(self) -> list:
        return [a for a in self.agents if a.status == "active"]

    def reserved(self) -> list:
        return [a for a in self.agents if a.status == "reserved"]

    def find(self, name: str) -> Optional["AgentEntry"]:
        for a in self.agents:
            if a.name == name:
                return a
        return None

    def name_taken(self, name: str) -> bool:
        # A *reserved* name is taken too: reserving exists precisely so the name
        # cannot be handed to someone else before its agent starts (issue #422).
        return any(a.name == name for a in self.agents)

    def next_number(self, role: str) -> int:
        # A reserved entry consumes its number: a reserve-then-promote flow must
        # not later allocate the same <role>-<n> to a *different* agent.
        used = [parse_agent_name(a.name)["n"] for a in self.agents
                if parse_agent_name(a.name)
                and parse_agent_name(a.name)["role"] == role]
        return (max(used) + 1) if used else 1


def read_roster(host: str, cwd: Optional[str] = None) -> Optional[Roster]:
    """The roster for a host, or None if it does not exist / is corrupt."""
    proc = git("log", "-1", "--format=%B", roster_ref_for(host), check=False, cwd=cwd)
    if proc.returncode != 0:
        return None
    body = (proc.stdout or "").strip()
    if not body:
        return None
    try:
        return Roster.from_dict(json.loads(body))
    except (ValueError, KeyError, json.JSONDecodeError):
        return None


def fetch_rosters(cwd: Optional[str] = None) -> None:
    """Best-effort refresh of the remote roster refs."""
    git("fetch", "--prune", "--force", "origin",
        f"+{ROSTER_PREFIX}/*:{ROSTER_PREFIX}/*", check=False, cwd=cwd)


def list_rosters(cwd: Optional[str] = None) -> dict:
    """Every host's roster, keyed by host (missing/corrupt refs skipped)."""
    proc = git("for-each-ref", "--format=%(refname)", ROSTER_PREFIX,
               check=False, cwd=cwd)
    result: dict = {}
    for ref in (proc.stdout or "").splitlines():
        ref = ref.strip()
        if not ref:
            continue
        host = ref[len(ROSTER_PREFIX) + 1:]
        roster = read_roster(host, cwd=cwd)
        if roster is not None:
            result[host] = roster
    return result


def _write_roster(host: str, roster: Roster, *, cwd: Optional[str] = None) -> None:
    """Publish a roster ref with a compare-and-swap, retrying on a lost race.

    A roster is a read-modify-write aggregate (like the notes log), so two
    registrations racing would otherwise drop one.  Retry against the fresh
    remote value; a credential failure is fatal (retrying cannot fix it).
    """
    for _ in range(5):
        fetch_rosters(cwd=cwd)
        ref = roster_ref_for(host)
        expect = _local_ref_sha(ref, cwd=cwd)
        commit = _empty_commit(roster.to_json(), cwd=cwd, env=_git_env())
        lease = f"--force-with-lease={ref}:{expect or ''}"
        proc = git("push", lease, "origin", f"{commit}:{ref}",
                   check=False, cwd=cwd, env=_git_env())
        if proc.returncode == 0:
            git("update-ref", ref, commit, check=False, cwd=cwd)
            return
        detail = (proc.stderr or proc.stdout or "").strip()
        hint = _push_hint(detail)
        if hint is not None:
            raise CoordAuthError(f"could not publish roster for {host}: "
                                 f"{hint}\n{detail}")
    raise CoordError(f"could not publish roster for {host}: the ref kept moving.")


def register_agent(host: str, role: str, model: str = "", *, name: str = "",
                   reserve: bool = False, cwd: Optional[str] = None) -> AgentEntry:
    """Register (or reserve) an agent on a host's roster.

    ``name`` may be supplied to pin an exact name (the PO names the agent in its
    prompt); otherwise the next free ``<role>-<n>-<host>`` is allocated.

    ``reserve=True`` records the name with status ``reserved`` instead of
    ``active``: it is a *placeholder* the SM creates when the PO requests an
    agent before the human has started it (issue #422).  A reserved name is
    taken (so it cannot be allocated to someone else) but is **not** a live
    agent, so it does not count against the daily budget and does not appear as
    active on the board.  Registering the reserved name again with ``name=``
    **promotes** it to active (``since`` becomes the real start) rather than
    being refused.
    """
    if not valid_host(host):
        raise CoordError(f"'{host}' is not a valid host "
                         f"(lowercase letters, digits, '.', '-' only).")
    fetch_rosters(cwd=cwd)
    roster = read_roster(host, cwd=cwd) or Roster(host=host)
    if name:
        parsed = parse_agent_name(name)
        if not parsed:
            raise CoordError(f"'{name}' is not a valid agent name "
                             f"(<role>-<n>-<host>, e.g. ta-1-{host}).")
        if parsed["host"] != host:
            raise CoordError(f"agent name '{name}' names host '{parsed['host']}', "
                             f"not '{host}'.")
        existing = roster.find(name)
        if existing is not None:
            # Promote a reservation to a real agent; never reuse a live/retired
            # name (a worker starts with no memory of its predecessor).
            if existing.status == "reserved" and not reserve:
                existing.status = "active"
                existing.since = now()
                if model:
                    existing.model = model
                if role and not existing.role:
                    existing.role = role
                _touch_budget(roster)
                roster.updated = now()
                _write_roster(host, roster, cwd=cwd)
                return existing
            raise CoordError(f"agent name '{name}' is already on {host}'s roster "
                             f"({existing.status}); names are never reused.")
    else:
        number = roster.next_number(role)
        name = f"{role}-{number}-{host}"
        if not reserve:
            # A reserved name for this role consumed a number, so the allocation
            # skipped past it. Say so: silence is what let po-2 appear with no
            # explanation (issue #422).
            skipped = [a.name for a in roster.reserved()
                       if parse_agent_name(a.name)
                       and parse_agent_name(a.name)["role"] == role]
            if skipped:
                print(f"note: reserved {', '.join(sorted(skipped))}; "
                      f"allocated {name}", file=sys.stderr)
    entry = AgentEntry(name=name, role=role, model=model,
                       status="reserved" if reserve else "active",
                       since=0 if reserve else now())
    roster.agents.append(entry)
    if not reserve:
        _touch_budget(roster)
    roster.updated = now()
    _write_roster(host, roster, cwd=cwd)
    return entry


def retire_agent(host: str, name: str, *, succeeded_by: str = "",
                 cwd: Optional[str] = None) -> AgentEntry:
    """Mark an agent retired (dead / replaced), recording its successor.

    Retirement is not deletion: the roster is the durable lineage a replacement
    (or the other SM) reads, so a name that is gone from the active list is still
    explained.
    """
    if not valid_host(host):
        raise CoordError(f"'{host}' is not a valid host.")
    fetch_rosters(cwd=cwd)
    roster = read_roster(host, cwd=cwd)
    if roster is None:
        raise CoordError(f"no roster for host '{host}'.")
    for entry in roster.agents:
        if entry.name == name:
            entry.status = "retired"
            if succeeded_by:
                entry.succeeded_by = succeeded_by
            roster.updated = now()
            _write_roster(host, roster, cwd=cwd)
            return entry
    raise CoordError(f"'{name}' is not on {host}'s roster.")


def _touch_budget(roster: Roster) -> None:
    """Count one new agent against today's per-host budget estimate."""
    day = iso(now())[:10]
    budget = roster.budget or {}
    if budget.get("date") != day:
        budget = {"date": day, "started": 0, "cap": budget.get("cap", DEFAULT_BUDGET_CAP)}
    budget["started"] = int(budget.get("started", 0)) + 1
    roster.budget = budget


def _git_env() -> dict:
    """Identity for the throwaway ledger commits (never touches user config)."""
    env = dict(os.environ)
    env.setdefault("GIT_AUTHOR_NAME", "coord-ledger")
    env.setdefault("GIT_AUTHOR_EMAIL", "coord@localhost")
    env.setdefault("GIT_COMMITTER_NAME", "coord-ledger")
    env.setdefault("GIT_COMMITTER_EMAIL", "coord@localhost")
    return env


def _local_ref_sha(ref: str, cwd: Optional[str] = None) -> Optional[str]:
    proc = git("rev-parse", "--verify", "--quiet", ref, check=False, cwd=cwd)
    sha = (proc.stdout or "").strip()
    return sha or None


def _empty_commit(message: str, *, cwd: Optional[str] = None, env: Optional[dict] = None) -> str:
    return _run(["git", "commit-tree", _EMPTY_TREE, "-m", message],
                cwd=cwd, env=env).stdout.strip()


def _commit_leases(leases: list["Lease"], *, expects: dict[str, Optional[str]],
                   cwd: Optional[str] = None) -> None:
    """Atomically publish one or more leases, one ref per area.

    ``expects`` maps each area ref to the remote value the caller last saw
    (``None`` = "do not care", ``""`` = "must not exist yet").  A single
    ``git push --atomic --force-with-lease`` publishes every ref or none: the
    per-ref lease is the compare-and-swap that makes a claim safe without a lock
    server, and ``--atomic`` makes a multi-area claim all-or-nothing.  Refs are
    sorted so two concurrent multi-area claims cannot interleave into a deadlock
    (git rejects a non-fast-forward atomically; the loser just retries).
    """
    env = _git_env()
    refspecs = []
    published: list[tuple[str, str]] = []
    push_args = ["push", "--atomic"]
    for lease in sorted(leases, key=lambda l: l.area):
        ref = ref_for(lease.area)
        commit = _empty_commit(lease.to_json(), cwd=cwd, env=env)
        expect = expects.get(ref)
        if expect is None:
            refspecs.append(f"+{commit}:{ref}")  # per-ref force: "do not care"
        else:
            push_args.append(f"--force-with-lease={ref}:{expect}")
            refspecs.append(f"{commit}:{ref}")
        published.append((ref, commit))
    push_args += ["origin", *refspecs]
    proc = git(*push_args, check=False, cwd=cwd, env=env)
    if proc.returncode != 0:
        detail = (proc.stderr or proc.stdout or "").strip()
        hint = _push_hint(detail)
        if hint is not None:
            raise CoordAuthError(f"could not publish lease(s) "
                                 f"{', '.join(l.area for l in leases)}: {hint}\n{detail}")
        raise CoordError(
            f"could not publish lease(s) {', '.join(l.area for l in leases)} "
            f"(someone else wrote first - re-run to see the new state):\n"
            f"{detail}"
        )
    # Keep the local mirror in step with the remote so the next read sees it
    # without waiting for a fetch.
    for ref, commit in published:
        git("update-ref", ref, commit, check=False, cwd=cwd)


def refs_for_area(area: str, cwd: Optional[str] = None) -> list[str]:
    """Every lease ref that belongs to ``area``.

    Normally that is exactly ``refs/coord/leases/<area>``.  It also picks up
    refs left in the *old* per-issue layout (``refs/coord/leases/<area>/<n>``)
    by an agent running a pre-fix client, so ``sweep`` can clear them.
    """
    prefix = f"{REF_PREFIX}/{area}"
    return [r for r in list_refs(cwd) if r == prefix or r.startswith(prefix + "/")]


def _delete_lease_ref(ref: str, cwd: Optional[str] = None) -> None:
    """Delete one lease ref on the remote, raising if it did not go.

    A ref that still exists on the remote is still held: reporting a release
    that never landed strands the area until its TTL expires (issue #392 - the
    same silent-success class as #381). A credential failure is reported as
    such (ADR-0033), not as a lost race. The local mirror is dropped only once
    the remote actually dropped it, so local state never claims a release the
    remote refused.
    """
    proc = git("push", "origin", f":{ref}", check=False, cwd=cwd)
    if proc.returncode != 0:
        detail = (proc.stderr or proc.stdout or "").strip()
        hint = _push_hint(detail)
        if hint is not None:
            raise CoordAuthError(f"could not delete {ref} on the remote: "
                                 f"{hint}\n{detail}")
        raise CoordError(f"could not delete {ref} on the remote (it is still "
                         f"held):\n{detail}")
    git("update-ref", "-d", ref, check=False, cwd=cwd)


def delete_refs_for_area(area: str, cwd: Optional[str] = None) -> None:
    """Delete every lease ref for ``area``, or raise if any survives.

    Deleting a ref that is already gone is a no-op that git reports as success,
    so this is safe to call when the remote is only suspected of holding one.
    """
    for ref in refs_for_area(area, cwd) or [ref_for(area)]:
        _delete_lease_ref(ref, cwd=cwd)


def clear_legacy_refs(area: str, cwd: Optional[str] = None) -> bool:
    """Delete any old-layout ``<area>/<issue>`` refs, in a separate push.

    Git refuses to create ``leases/world`` while ``leases/world/200`` exists
    (file/directory conflict), and it checks that before running an atomic
    transaction - so the delete cannot share the claim's push.  Called by
    ``--takeover``: the human has just named the agent they are displacing, so
    dropping its ref is announced, not silent.  Returns True if anything went.
    """
    ref = ref_for(area)
    stale = [r for r in refs_for_area(area, cwd) if r != ref]
    for r in stale:
        _delete_lease_ref(r, cwd=cwd)
    return bool(stale)


def delete_ref(area: str, cwd: Optional[str] = None) -> None:
    delete_refs_for_area(area, cwd)


def area_holder(area: str, at: Optional[int] = None, cwd: Optional[str] = None) -> Optional[Lease]:
    """The live lease holding ``area`` right now, if any."""
    live = [l for l in list_leases(cwd) if l.area == area and l.is_live(at)]
    if not live:
        return None
    return max(live, key=lambda l: l.epoch)


def current_branch(cwd: Optional[str] = None) -> str:
    """The branch checked out right now, or "" (detached HEAD / no repo)."""
    proc = git("rev-parse", "--abbrev-ref", "HEAD", check=False, cwd=cwd)
    if proc.returncode != 0:
        return ""
    name = (proc.stdout or "").strip()
    return "" if name == "HEAD" else name


def lease_is_mine(lease: Lease, agent: str, branch: str) -> bool:
    """Is ``lease`` held by *this* workspace, not a same-named peer?

    A lease records only the self-asserted ``agent`` string, and the docs tell
    agents to use their *model* name - which is not unique. Two workspaces running
    the same model collide on that string, and the ledger cannot tell them apart,
    so `next` would report a peer's lease as yours and `release`/`renew` would let
    you free it (issue #365).

    The recorded ``branch`` is the tiebreaker: a lease is yours only when the
    agent matches *and* the branch it names is the branch you are on. A branchless
    lease (legacy, or claimed without ``--branch``) has nothing to compare, so it
    matches by name alone - that is the pre-#365 behaviour, kept so nothing that
    exists today breaks.
    """
    if lease.agent != agent:
        return False
    if not lease.branch or not branch:
        return True
    return lease.branch == branch


# --------------------------------------------------------------------------- #
# Commands
# --------------------------------------------------------------------------- #

def cmd_claim(args: argparse.Namespace) -> int:
    fetch_ledger(required=True)
    at = now()
    area, issue = args.area, args.issue
    ref = ref_for(area)
    existing = read_lease(ref)
    local_sha = _local_ref_sha(ref)

    # A pre-fix client's ref (old per-issue layout) blocks the area ref, so the
    # push below would fail with a raw git error.  --takeover names the agent
    # being displaced, so clear it first; otherwise say exactly how to fix it.
    legacy = [r for r in refs_for_area(area) if r != ref]
    if legacy:
        if not args.takeover:
            raise CoordError(
                f"area '{area}' has a legacy per-issue ref ({legacy[0]}) from an "
                f"outdated client; it blocks the area ref. Run `scripts/coord "
                f"sweep`, or re-run with --takeover to clear it now."
            )
        clear_legacy_refs(area)
        fetch_ledger(required=True)
        existing = read_lease(ref)
        local_sha = _local_ref_sha(ref)

    holder = area_holder(area, at)

    if holder is not None and holder.issue != issue and not args.takeover:
        raise CoordError(
            f"area '{area}' is held by {holder.agent} on #{holder.issue} "
            f"until {iso(holder.expires)} ({human_delta(holder.expires - at)} left). "
            f"Pick another area, or wait for expiry."
        )
    if existing is not None and existing.is_live(at) and existing.agent != args.agent and not args.takeover:
        raise CoordError(
            f"#{issue} is already claimed by {existing.agent} until "
            f"{iso(existing.expires)}. Use --takeover to take it (announced, not silent)."
        )

    ttl = min(args.ttl, MAX_TTL)
    lease = Lease(
        agent=args.agent, area=area, issue=issue, branch=args.branch or "",
        state="claimed", epoch=at, ttl=ttl, note=args.note or "",
    )
    # CAS expectation: the ref value we last saw. "" means "must not exist".
    expect = local_sha if local_sha else ""
    try:
        _commit_leases([lease], expects={ref: expect})
    except CoordAuthError:
        # Not a race: the ledger did not move, we could not reach it.  Surface
        # the auth diagnosis instead of blaming a phantom concurrent writer.
        raise
    except CoordError as exc:
        # Someone raced us.  Re-read and report the real holder, so the caller
        # gets an actionable message instead of raw git output.  The re-read is
        # required: reporting "no live holder" off a failed fetch would be a lie.
        fetch_ledger(required=True)
        holder = area_holder(area, at)
        if holder is not None and holder.issue != issue:
            raise CoordError(
                f"lost the race for area '{area}': now held by {holder.agent} "
                f"on #{holder.issue} until {iso(holder.expires)}"
            )
        if holder is not None:
            raise CoordError(
                f"lost the race for #{issue} in '{area}': now held by {holder.agent} "
                f"until {iso(holder.expires)}. Use --takeover to take it."
            )
        raise CoordError(
            f"could not publish the lease for {area}/#{issue}; the ledger moved "
            f"under us. Re-run `scripts/coord status` and try again."
        ) from exc

    verb = "took over" if args.takeover else "claimed"
    print(f"{verb} {area} / #{issue} for {args.agent} "
          f"(expires {iso(lease.expires)}, ttl {human_delta(ttl)})")
    if args.branch:
        print(f"branch: {args.branch}")
    return 0


def cmd_renew(args: argparse.Namespace) -> int:
    fetch_ledger(required=True)
    ref = ref_for(args.area)
    lease = read_lease(ref)
    if lease is None:
        raise CoordError(f"no lease on {args.area}/#{args.issue} to renew")
    branch = getattr(args, "branch", None) or current_branch()
    if not lease_is_mine(lease, args.agent, branch) and not args.force:
        raise CoordError(f"{args.area}/#{args.issue} is held by {lease.agent}"
                         + (f" on {lease.branch}" if lease.branch else "")
                         + f", not {args.agent}"
                         + (f" on {branch}" if lease.branch and branch else ""))
    lease.epoch = now()
    if args.ttl:
        lease.ttl = min(args.ttl, MAX_TTL)
    if args.state:
        lease.state = args.state
    if args.note is not None:
        lease.note = args.note
    expect = _local_ref_sha(ref) or ""
    _commit_leases([lease], expects={ref: expect})
    print(f"renewed {args.area} / #{args.issue} for {args.agent} "
          f"(expires {iso(lease.expires)}, state {lease.state})")
    return 0


def _is_github_remote() -> bool:
    """True if 'origin' looks like a GitHub remote (so `gh` label calls make sense)."""
    proc = git("remote", "get-url", "origin", check=False)
    return proc.returncode == 0 and "github.com" in (proc.stdout or "")


def cmd_release(args: argparse.Namespace) -> int:
    fetch_ledger(required=True)
    lease = read_lease(ref_for(args.area))
    if lease is None:
        print(f"nothing to release on {args.area}/#{args.issue}")
        return 0
    branch = getattr(args, "branch", None) or current_branch()
    if not lease_is_mine(lease, args.agent, branch) and not args.force:
        raise CoordError(f"{args.area}/#{args.issue} is held by {lease.agent}"
                         + (f" on {lease.branch}" if lease.branch else "")
                         + f", not {args.agent}"
                         + (f" on {branch}" if lease.branch and branch else ""))
    delete_ref(args.area)
    # `delete_ref` raises if the remote refused the delete (or is unreachable), so
    # reaching here means the ref is actually gone: a release that did not land
    # must not print success (issue #392, the same silent-success class as #381).
    # Drop the convenience `status:` mirror immediately rather than waiting up to
    # a sweep interval.  Best-effort and only against a real GitHub remote, so a
    # local test run never touches the network.  (`sweep --gh` is the backstop.)
    if _is_github_remote():
        _sync_issue(lease, live=False)
    print(f"released {args.area} / #{args.issue}")
    return 0


def cmd_status(args: argparse.Namespace) -> int:
    if not args.offline:
        fetch_ledger(required=True)
        fetch_rosters()
    at = now()
    leases = sorted(list_leases(), key=lambda l: (l.area, l.issue))
    if args.json:
        print(json.dumps([
            {**json.loads(l.to_json()),
             "expires": l.expires, "live": l.is_live(at), "stale": l.is_stale(at)}
            for l in leases
        ], indent=2))
        return 0

    live = [l for l in leases if l.is_live(at)]
    expired = [l for l in leases if not l.is_live(at)]
    print(f"live leases: {len(live)}   expired (awaiting sweep): {len(expired)}")
    for l in live:
        flag = "STALE " if l.is_stale(at) else "      "
        state = "" if l.state == "claimed" else f"[{l.state}] "
        host = agent_host(l.agent)
        print(f"  {flag}{l.area:<9} #{l.issue:<5} {state}{l.agent}  "
              f"expires {iso(l.expires)} ({human_delta(l.expires - at)} left)"
              + (f"  host={host}" if host else "")
              + (f"  branch={l.branch}" if l.branch else ""))
    if expired:
        print("expired (a `sweep` will delete these):")
        for l in expired:
            print(f"         {l.area:<9} #{l.issue:<5} {l.agent}  "
                  f"expired {iso(l.expires)} ({human_delta(at - l.expires)} ago)")
    free = [a for a in AREAS if area_holder(a, at) is None]
    print(f"free areas: {', '.join(free) if free else '(none)'}")
    rosters = list_rosters()
    for host in sorted(rosters):
        roster = rosters[host]
        budget = roster.budget or {}
        spend = (f"  today {budget.get('started', 0)}/{budget.get('cap', '?')}"
                 if budget.get("started") is not None else "")
        active = ", ".join(a.name for a in roster.active()) or "(none)"
        reserved = [a.name for a in roster.reserved()]
        if reserved:
            active += f"  (reserved: {', '.join(reserved)})"
        print(f"roster {host}: {active}{spend}")
    return 0


def _open_issues_by_area() -> dict[str, list[tuple[int, bool]]]:
    """Open issues bucketed by their `focus:` label: ``(issue, is_blocker)``.

    Issues that are not claimable work are skipped: `status: blocked` (waiting on
    another area), `question` (a human decision), and `deferred: v2` (out of scope,
    ADR-0024).  Routing an idle agent to one of those is a wasted cycle, so `next`
    must not offer them.

    ``is_blocker`` is true for a Rule 4 request (`status: needs-review`): another
    lane is *waiting* on it (FOCUS_AREAS §4 Rule 4), so clearing it unblocks more
    than any other item.  Each area's list is ordered blockers first, newest first
    within each rank.  Returns an empty map on any failure: `next` must still
    produce an action when GitHub is unreachable, so this never raises.
    """
    try:
        proc = gh("issue", "list", "--state", "open", "--limit", "200",
                  "--json", "number,labels,createdAt", check=False)
    except OSError:  # gh binary absent
        return {}
    if proc.returncode != 0:
        return {}
    try:
        rows = json.loads(proc.stdout or "[]")
    except json.JSONDecodeError:
        return {}
    # A Rule 4 request sorts ahead of plain work; ties broken newest first.
    rows.sort(key=lambda r: r.get("createdAt", ""), reverse=True)
    buckets: dict[str, list[tuple[int, bool]]] = {}
    for row in rows:
        names = {label.get("name", "") for label in row.get("labels", [])}
        if names & NOT_CLAIMABLE_LABELS:
            continue
        blocker = "status: needs-review" in names
        for name in names:
            if name.startswith("focus: "):
                buckets.setdefault(name[len("focus: "):], []).append(
                    (int(row["number"]), blocker))
    return {area: sorted(items, key=lambda t: not t[1])
            for area, items in buckets.items()}


def _now_epoch() -> int:
    """The wall clock as an epoch, honouring the test override.

    ``coord now()`` in scripts/coord is the ledger's clock (it also feeds
    ``COORD_NOW``); this reads the *real* time so a fake ledger clock in the tests
    does not age every PR to "drainable".  Tests stub whole helpers instead.
    """
    override = os.environ.get("COORD_NOW")
    if override:
        try:
            return int(override)
        except ValueError:
            pass
    return int(time.time())


def _drainable_prs(min_age: int = MERGE_DRAIN_MIN_AGE) -> list[dict]:
    """Open, non-draft PRs whose checks are green and that have waited a while.

    A PR that is finished, reviewed, and green is work *one step from landing*;
    leaving it open is the most expensive kind of idle — the work is done and
    worth nothing until merged.  So `next` offers the oldest such PR to be
    adopted and merged (AGENTS.md §3a) rather than letting a fresh agent start
    new work and orphan the PR.  Returns ``[]`` on any failure (gh absent,
    offline, no auth): `next` must still answer, so this never raises.

    A PR counts as drainable when all hold:
      * it is ``OPEN`` and **not a draft** (a draft is not finished);
      * its merge state is ``CLEAN`` (mergeable, checks green, no conflicts);
      * it has been open at least ``min_age`` seconds (the floor that stops a
        claim from being abandoned the moment a peer pushes).
    The oldest PR is offered first, so the queue drains FIFO and a *stuck* PR
    (any kind of stall) is reached before a merely young one.
    """
    try:
        proc = gh("pr", "list", "--state", "open", "--limit", "50", "--json",
                  "number,title,isDraft,mergeStateStatus,createdAt", check=False)
    except OSError:  # gh binary absent
        return []
    if proc.returncode != 0:
        return []
    try:
        rows = json.loads(proc.stdout or "[]")
    except json.JSONDecodeError:
        return []
    at = _now_epoch()
    drainable = []
    for row in rows:
        if row.get("isDraft"):
            continue
        if (row.get("mergeStateStatus") or "").upper() != "CLEAN":
            continue
        created = _iso_epoch(row.get("createdAt", ""))
        if created is None:
            continue
        if at - created < min_age:
            continue
        drainable.append({**row, "_age": at - created})
    drainable.sort(key=lambda r: r["_age"], reverse=True)
    return drainable


def _iso_epoch(stamp: str) -> Optional[int]:
    """Parse a GitHub ISO-8601 timestamp (``...Z``) into an epoch, or None."""
    if not stamp:
        return None
    try:
        text = stamp.replace("Z", "+00:00")
        return int(datetime.fromisoformat(text).timestamp())
    except ValueError:
        return None


def _takeover_requests() -> list:
    """Open takeover requests on the `takeover` channel, newest first.

    A takeover request is how a live agent asks the fleet to pick up an area
    whose holder has gone quiet without silently displacing it
    (docs/ORGANISATION.md section 6a).  ``next`` surfaces them so an agent that finds
    itself idle claims the work instead of leaving the request unread.  Returns
    ``[]`` on any failure: ``next`` must always answer.
    """
    try:
        notes = read_notes("takeover")
    except Exception:  # pragma: no cover - read_notes already swallows git errors
        return []
    return [n for n in notes if "TAKEOVER REQUEST" in n.text]


def _requested_area(text: str) -> Optional[str]:
    m = re.search(r"area=([a-z0-9-]+)", text or "")
    return m.group(1) if m else None


def _roadmap_gaps(limit: int = 3) -> list[str]:
    """The first unchecked roadmap items — the seed when the backlog is empty."""
    try:
        with open(ROADMAP_PATH, encoding="utf-8") as fh:
            text = fh.read()
    except OSError:
        return []
    gaps = []
    for line in text.splitlines():
        stripped = line.strip()
        if stripped.startswith("- [ ]"):
            gaps.append(stripped[len("- [ ]"):].strip())
            if len(gaps) >= limit:
                break
    return gaps


def cmd_next(args: argparse.Namespace) -> int:
    """Print the single next action for an idle agent — never empty.

    The fleet must never stall for want of something to do.  This walks a fixed
    ladder and stops at the first rung that applies, so the answer is always an
    actionable next step, even when every area is taken and the issue list is
    empty:

      1. you already hold a lease        -> renew / finish / release it
      1b. you are an SM and an SM-owned area is free
                                         -> claim its next claimable issue (the
                                            SM triggers infrastructure itself)
      2. a critical-path area is free    -> claim its next claimable issue
      2b. a takeover request is open     -> pick up the quiet holder's work
      3. a green PR has waited           -> review and merge it (drain the queue)
      4. any free area has an issue      -> claim its next claimable issue
      5. any area is free but has no issue, or a live lease is stale
                                         -> file the roadmap gap as a new issue
      6. nothing is claimable at all     -> review an open PR you did not author
                                            (the fleet's other durable job)

    "Next claimable" skips unclaimable issues (`status: blocked`, `question`,
    `deferred: v2`) and treats a Rule 4 request (`status: needs-review`) as a
    *blocker*: another lane is waiting on it (FOCUS_AREAS §4), so a blocker in any
    free critical-path area is offered before plain work in the first one
    (ADR-0026).  Rung 3 sits between them by design: a green, non-draft PR is
    *finished* work one step from landing, so merging it beats *starting* new work
    even in a free non-critical area, but it never preempts a waiting blocker or
    the critical path (ADR-0035).

    The SM-owned area (`rules`) is the Scrum Master's *own* lane - the process
    docs themselves, which are coordination work, not game content (ADR-0041).
    Everything else, including `platform` (build/CI/scripts/packaging), is a
    normal WORKER lane: the SM is never routed to game or build work, so it
    cannot be dragged into project work by a mislabelled issue.  A plain worker
    is never routed to `rules`; an agent whose name has role `sm` is offered it
    at rung 1b, and with that lane held it falls through to its durable jobs
    (drain the merge queue, review).
    """
    if not args.offline:
        fetch_ledger(required=True)
    at = now()
    leases = [l for l in list_leases() if l.is_live(at)]
    by_area = _open_issues_by_area()

    # 1. Do you already hold something?  Finish or renew it before taking more.
    #    Match on agent *and* branch: a legacy agent string is a model name, not
    #    a unique id, so a same-named peer's lease must not be reported as yours
    #    (issue #365).  A named agent (`<role>-<n>-<host>`) is unique, but the
    #    branch check is kept for the legacy ledger.
    branch = getattr(args, "branch", None) or current_branch()
    mine = [l for l in leases if lease_is_mine(l, args.agent, branch)]
    if mine:
        l = mine[0]
        state = "" if l.state == "claimed" else f" [{l.state}]"
        print(f"You hold {l.area} / #{l.issue}{state} "
              f"({human_delta(l.expires - at)} left).")
        print(f"  -> renew:   scripts/coord renew  --area {l.area} --issue {l.issue} "
              f"--agent \"{args.agent}\"")
        print(f"  -> release: scripts/coord release --area {l.area} --issue {l.issue} "
              f"--agent \"{args.agent}\"")
        return 0

    # Same model name, but a different workspace's lease (a branch you are not
    # on).  Say so: otherwise the agent sees its name on the board and assumes it
    # owns that work (issue #365).
    namesakes = [l for l in leases if l.agent == args.agent and l.branch and l.branch != branch]
    if namesakes:
        l = namesakes[0]
        print(f"'{args.agent}' also holds {l.area} / #{l.issue} on branch "
              f"'{l.branch}' - not this workspace"
              + (f" (you are on '{branch}')" if branch else "")
              + ".")

    holders = {l.area: l for l in leases}
    # The SM's own lane (`rules`) is the process docs - coordination work, not
    # game content (ADR-0041).  Every other area, including `platform`, is a
    # normal WORKER lane: a plain worker is never routed to `rules`, and the SM
    # is never routed to game or build work.  With its own lane held, the SM
    # falls through to the merge queue and review rungs below, which are its
    # other durable jobs (docs/ORGANISATION.md section 7).
    parsed = parse_agent_name(args.agent)
    is_sm = bool(parsed and parsed["role"] == "sm")
    routable = SM_OWNED_AREAS if is_sm else WORKER_AREAS
    free = [a for a in routable if a not in holders]

    # 1b. An SM that is idle looks at its own lane first: the SM triggers its own
    #     coordination work rather than waiting for the PO to schedule it.
    if is_sm:
        for area in free:
            if by_area.get(area):
                return _emit_claim(area, by_area[area][0][0])

    # 2. Critical path first.  A waiting blocker (a Rule 4 request another lane is
    #    blocked on) outranks plain work anywhere, because clearing it unblocks a
    #    peer (FOCUS_AREAS §4 Rule 4, ADR-0026).  So look for a blocker in *any*
    #    free critical-path area before a plain issue in the first one.
    critical = [a for a in CRITICAL_PATH_AREAS if a in routable]
    for area in critical:
        if area in free and by_area.get(area) and by_area[area][0][1]:
            return _emit_claim(area, by_area[area][0][0], critical=True)
    for area in critical:
        if area in free and by_area.get(area):
            return _emit_claim(area, by_area[area][0][0], critical=True)

    # 2b. A takeover request another agent filed (the holder went quiet).  This
    #     is cooperative, low-cost reclamation: the request is a *hint* on the
    #     `takeover` channel, not an authority, so it is offered before draining
    #     the queue but after the critical path (docs/ORGANISATION.md section 6a).
    for req in _takeover_requests():
        area = _requested_area(req.text)
        if area and area in free:
            print(f"Takeover request on '{area}' from {req.agent} "
                  f"({human_delta(at - req.epoch)} ago):")
            print(f"  {req.text}")
            print("  -> the area is free; claim it:")
            print(f"     scripts/coord claim --area {area} --issue <n> "
                  f"--agent \"{args.agent}\" --branch <type>/{area}-<slug>")
            return 0

    # 3. Drain the merge queue.  A green, non-draft PR that has waited is finished
    #    work one step from landing: merging it costs almost nothing and is worth
    #    more than *starting* new work, which commits a whole cycle and risks
    #    orphaning the PR that was already done.  This outranks a non-critical
    #    claim (ADR-0035) — it is the rung that stops "6 free areas, one green PR
    #    unmerged for an hour".
    drainable = _drainable_prs()
    if drainable:
        pr = drainable[0]
        age = human_delta(pr["_age"])
        print(f"Merge queue: PR #{pr['number']} is green, non-draft, and {age} old "
              f"(no author needed).")
        print(f"  {pr['title']}")
        print("  -> review and merge it (AGENTS.md §3a):")
        print(f"     gh pr view {pr['number']} && gh pr merge {pr['number']} --squash")
        return 0

    # 4. Any free area with work.
    for area in free:
        if by_area.get(area):
            return _emit_claim(area, by_area[area][0][0])

    # 5. Free areas exist but the backlog is empty -> seed it.
    gaps = _roadmap_gaps()
    if free:
        area = next((a for a in CRITICAL_PATH_AREAS if a in free), free[0])
        print(f"No open issue is claimable, but area '{area}' is free.")
        if gaps:
            print("Seed it from the roadmap (docs/ROADMAP.md), e.g.:")
            for gap in gaps:
                print(f"  - {gap}")
            print(f"  -> file an issue with a `focus: {area}` label, then claim it.")
        else:
            print(f"  -> file an issue with a `focus: {area}` label, then claim it.")
        print("  (Every area is idle: this is the fleet's only stop condition, and it")
        print("   is fixed by adding work, not by adding agents.)")
        return 0

    # 6. Everything is held (or stale).  Fall through to the other durable job.
    stale = [l for l in leases if l.is_stale(at)]
    if stale:
        l = stale[0]
        print(f"Every area is held; '{l.area}' (#{l.issue}, {l.agent}) is stale "
              f"({human_delta(at - l.epoch)} quiet).")
        print(f"  -> request a takeover: scripts/coord takeover --request "
              f"--area {l.area} --agent \"{args.agent}\"")
        print(f"  -> or claim it directly: scripts/coord claim --area {l.area} "
              f"--issue {l.issue} --agent \"{args.agent}\" --takeover")
        print("  -> or review its PR first if one is open.")
        return 0

    print("Every area is held by a live, non-stale lease.")
    print("  -> review and merge an open PR you did not author (AGENTS.md §3a):")
    print("     gh pr list --state open --json number,title,headRefName")
    print("  -> this is the fleet's second durable job; it is always available.")
    return 0


def _emit_claim(area: str, issue: int, critical: bool = False) -> int:
    tag = " (critical path)" if critical else ""
    print(f"Next: claim {area} / #{issue}{tag}")
    print(f"  scripts/coord claim --area {area} --issue {issue} "
          f"--agent \"<role>-<n>-<host>\" --branch <type>/{area}-<slug>")
    return 0


def cmd_check(args: argparse.Namespace) -> int:
    """CI gate: two live leases must never collide on an area or an issue."""
    if not args.offline:
        fetch_ledger(required=True)
    at = now()
    leases = list_leases()
    live = [l for l in leases if l.is_live(at)]
    problems: list[str] = []
    by_area: dict[str, list[Lease]] = {}
    by_issue: dict[int, list[Lease]] = {}
    for l in live:
        by_area.setdefault(l.area, []).append(l)
        by_issue.setdefault(l.issue, []).append(l)
    for area, group in by_area.items():
        if len(group) > 1:
            who = ", ".join(f"{l.agent}#{l.issue}" for l in group)
            problems.append(f"area '{area}' has {len(group)} live leases: {who}")
    for issue, group in by_issue.items():
        if len(group) > 1:
            who = ", ".join(f"{l.agent}@{l.area}" for l in group)
            problems.append(f"#{issue} has {len(group)} live leases: {who}")
    # A ref in the old per-issue layout means a client predating the area-keyed
    # ledger is still running; that is the one way a real collision can appear.
    for ref in list_refs():
        if len(ref[len(REF_PREFIX) + 1:].split("/")) != 2:
            continue
        legacy = read_lease(ref)
        if legacy is not None and legacy.is_live(at):
            problems.append(
                f"legacy per-issue ref '{ref}' ({legacy.agent}) - an outdated "
                f"client wrote it. Run `coord sweep` to clear it.")
    for p in problems:
        print(f"::error::coordination conflict: {p}")
    if problems:
        print(f"\n{len(problems)} live coordination conflict(s). "
              f"Release one lease (`coord release`) or let it expire, then re-run.")
        return 1
    print(f"coordination check OK: {len(live)} live lease(s), no collisions.")
    return 0


def _board_rows(at: int) -> list[tuple[str, str, str, str]]:
    """(area, holder, state, remaining) for each focus area."""
    leases = list_leases()
    rows = []
    for area in AREAS:
        group = [l for l in leases if l.area == area]
        live = [l for l in group if l.is_live(at)]
        name = f"{area} (SM)" if area in SM_OWNED_AREAS else area
        if live:
            l = max(live, key=lambda x: x.epoch)
            state = l.state if l.state != "claimed" else ("stale" if l.is_stale(at) else "claimed")
            rows.append((name, f"{l.agent} · #{l.issue}", state, human_delta(l.expires - at)))
        else:
            rows.append((name, "—", "free", "—"))
    return rows


def render_board(at: Optional[int] = None) -> str:
    at = at if at is not None else now()
    rows = _board_rows(at)
    lines = [
        BOARD_MARKER,
        "<!-- AI/LLM-generated file. Do not treat as human-written source documentation. -->",
        "<!-- Generated by `scripts/coord board`. Do NOT edit by hand: the next",
        "     sweep overwrites it. Edit the leases (`coord claim/renew/release`)",
        "     or the issues; this board follows. -->",
        "",
        "# Coordination board (generated)",
        "",
        "A live view of the **lease ledger** (`refs/coord/leases/*`). This file is a",
        "generated *view*; the ledger is the source of truth. Regenerated on every",
        "sweep and on every push that touches a lease (`.github/workflows/coordination.yml`).",
        "",
        f"_As of {iso(at)}._",
        "",
        "| Area | Holder | State | TTL left |",
        "|------|--------|-------|----------|",
    ]
    for area, holder, state, remaining in rows:
        lines.append(f"| `{area}` | {holder} | {state} | {remaining} |")
    lines += [
        "",
        "Legend: **free** = claimable now · **claimed** = live lease · **stale** = live",
        f"but quiet for > {human_delta(STALE_AFTER)} — the holder may still be working, but a",
        "`coord claim --takeover` (or letting the TTL run out) is fair game · **blocked** /",
        "**needs-review** = the holder set the state. Pending workload per area is the",
        "open-issue count on GitHub. **(SM)** marks the Scrum Master's own lane",
        "(`rules`, the process docs): the SM triggers it and a plain worker is",
        "never routed to it (docs/ORGANISATION.md §1, ADR-0041).",
        "",
    ]

    rosters = list_rosters()
    if rosters:
        lines += [
            "## Roster",
            "",
            "Named agents per host (`refs/coord/roster/<host>`, `scripts/coord agent "
            "--list`). A name is `<role>-<n>-<host>` and is never reused. The daily "
            "new-agent budget is shared across computers and other projects; the "
            "`started/cap` figure here is a per-host estimate only.",
            "",
        ]
        for host in sorted(rosters):
            roster = rosters[host]
            budget = roster.budget or {}
            started, cap = budget.get("started"), budget.get("cap")
            spend = f" — {started}/{cap} new agents today" if started is not None else ""
            lines.append(f"**`{host}`**{spend}")
            lines.append("")
            for a in roster.active():
                model = f" ({a.model})" if a.model else ""
                lines.append(f"- `{a.name}`{model} — active")
            if not roster.active():
                lines.append("- _(no active agents)_")
            for a in roster.reserved():
                lines.append(f"- `{a.name}` — reserved (not started)")
            for a in [a for a in roster.agents
                      if a.status not in ("active", "reserved")]:
                succ = f" → `{a.succeeded_by}`" if a.succeeded_by else ""
                lines.append(f"- `{a.name}` — retired{succ}")
            lines.append("")
        lines += [
            "Register a new agent: `scripts/coord agent --register --host <host> "
            "--role <area-code>`. Hold a name before its agent starts: "
            "`scripts/coord agent --reserve --host <host> --role <area-code> "
            "--name <name>` (then `--register` the same name to promote it). "
            "Retire one: `scripts/coord agent --retire <name> "
            "--host <host> --succeeded-by <name>`.",
            "",
        ]
    notes = list_all_notes()
    if notes:
        lines += [
            "## Handoff notes",
            "",
            "Cross-cycle notes left by earlier processes (`refs/coord/notes/*`). These",
            "outlive the lease that wrote them, so read them before starting an area:",
            "",
        ]
        for area in sorted(notes):
            lines.append(f"**`{area}`**")
            lines.append("")
            for n in notes[area]:
                when = iso(n.epoch) if n.epoch else "?"
                lines.append(f"- _{when}_ {n.agent}: {n.text}")
            lines.append("")
        lines += [
            "Add one with `scripts/coord note --area <area> --agent \"<role>-<n>-<host>\" --text \"...\"`.",
            "",
        ]
    lines += [
        "## How to take an area",
        "",
        "```bash",
        "scripts/coord claim --area world --issue 157 --agent \"<role>-<n>-<host>\" --branch feat/world-xyz",
        "# ... work ... then either:",
        "scripts/coord renew  --area world --issue 157 --agent \"<role>-<n>-<host>\"",
        "scripts/coord release --area world --issue 157 --agent \"<role>-<n>-<host>\"",
        "```",
        "",
        "See `docs/COORDINATION.md` for the full protocol.",
        "",
    ]
    return "\n".join(lines)


def cmd_board(args: argparse.Namespace) -> int:
    if not args.offline:
        fetch_ledger(required=True)
        fetch_rosters()
        fetch_notes()
    content = render_board()
    if args.stdout:
        print(content, end="")
        return 0
    path = args.path or BOARD_PATH
    os.makedirs(os.path.dirname(path) or ".", exist_ok=True)
    with open(path, "w", encoding="utf-8") as fh:
        fh.write(content)
    print(f"wrote {path}")
    return 0


def cmd_note(args: argparse.Namespace) -> int:
    """Append a cross-cycle note to an area's log."""
    append_note(args.area, args.agent, args.text)
    print(f"noted {args.area}: {args.text}")
    return 0


def cmd_notes(args: argparse.Namespace) -> int:
    """Print the notes for a topic, or every topic."""
    if not args.offline:
        fetch_notes()
    if args.area:
        areas = {args.area: read_notes(args.area)}
    else:
        areas = list_all_notes()
    if args.json:
        payload = {
            a: [{"agent": n.agent, "text": n.text, "epoch": n.epoch} for n in ns]
            for a, ns in areas.items()
        }
        print(json.dumps(payload, indent=2, sort_keys=True))
        return 0
    if not any(areas.values()):
        print("no notes.")
        return 0
    for area in sorted(areas):
        for n in areas[area]:
            when = iso(n.epoch) if n.epoch else "?"
            print(f"[{area}] {when} {n.agent}: {n.text}")
    return 0


def cmd_msg(args: argparse.Namespace) -> int:
    """Send a direct message to one named agent."""
    send_message(args.to, args.agent, args.text)
    print(f"msg -> {args.to}: {args.text}")
    return 0


def cmd_inbox(args: argparse.Namespace) -> int:
    """Print the messages addressed to one agent."""
    if not args.offline:
        fetch_messages()
    messages = read_messages(args.agent)
    if args.json:
        print(json.dumps([{"from": m.agent, "text": m.text, "epoch": m.epoch}
                          for m in messages], indent=2, sort_keys=True))
        return 0
    if not messages:
        print(f"no messages for {args.agent}.")
        return 0
    for m in messages:
        when = iso(m.epoch) if m.epoch else "?"
        print(f"[{when}] {m.agent} -> {args.agent}: {m.text}")
    return 0


def cmd_agent(args: argparse.Namespace) -> int:
    """Register, retire, or list the named agents on a host's roster.

    The roster is the durable record of *who* an agent is (name, role, model,
    status, successor).  It exists because a name is not just a label: the
    Product Owner requests agents by name, and a replacement must be a new name
    (a worker starts with no memory of its predecessor).  One ref per host keeps
    each computer's roster separate - a PO only ever sees its own host.
    """
    if args.register or args.reserve:
        host = args.host or default_host()
        role = args.role or ""
        if not role:
            raise CoordError("--register needs --role "
                             "(a focus-area code, or 'sm' / 'po')")
        if role not in CONFIG.roles and CONFIG.name_for_code(role) is None:
            valid = sorted(set(CONFIG.roles) |
                           {sp.get("code", "") for sp in CONFIG.areas.values()})
            raise CoordError(f"unknown role code '{role}'; valid: "
                             f"{', '.join(c for c in valid if c)}")
        entry = register_agent(host, role, model=args.model or "",
                               name=args.name or "", reserve=args.reserve)
        verb = "reserved" if entry.status == "reserved" else "registered"
        print(f"{verb} {entry.name} ({entry.role}"
              f"{', ' + entry.model if entry.model else ''})")
        return 0
    if args.retire:
        host = args.host or default_host()
        entry = retire_agent(host, args.retire,
                             succeeded_by=args.succeeded_by or "")
        succ = f" -> {entry.succeeded_by}" if entry.succeeded_by else ""
        print(f"retired {entry.name} on {host}{succ}")
        return 0
    if args.host:
        fetch_rosters()
        roster = read_roster(args.host)
        rosters = {args.host: roster} if roster else {}
    else:
        fetch_rosters()
        rosters = list_rosters()
    if args.json:
        print(json.dumps({h: json.loads(r.to_json()) for h, r in rosters.items()},
                         indent=2, sort_keys=True))
        return 0
    if not rosters:
        print("no rosters.")
        return 0
    for host in sorted(rosters):
        roster = rosters[host]
        budget = roster.budget or {}
        spend = (f"  today {budget.get('started', 0)}/{budget.get('cap', '?')} new agents"
                 if budget.get("started") is not None else "")
        print(f"[{host}]{spend}")
        for a in roster.agents:
            mark = {"active": "active ", "reserved": "reserved"}.get(a.status,
                                                                   "retired")
            model = f"  ({a.model})" if a.model else ""
            succ = f"  -> {a.succeeded_by}" if a.succeeded_by else ""
            print(f"  {mark} {a.name}{model}{succ}")
    return 0


def cmd_takeover(args: argparse.Namespace) -> int:
    """Post a takeover request, or list the open ones.

    A takeover *request* is the low-cost, cooperative alternative to a silent
    `--takeover`: a live agent whose peer has gone quiet posts a request on the
    `takeover` channel, and any agent that later finds itself idle checks the
    channel (`coord next` surfaces it) and picks the work up.  It is a request,
    never an authority: the requester does not itself displace a live holder
    (docs/ORGANISATION.md section 6a).
    """
    if args.request:
        if not args.area:
            raise CoordError("--request needs --area")
        at = now()
        lease = area_holder(args.area, at)
        if lease is None:
            print(f"{args.area} is free; nothing to take over.")
            return 0
        quiet = human_delta(at - lease.epoch)
        text = (f"TAKEOVER REQUEST: area={args.area} issue=#{lease.issue} "
                f"holder={lease.agent} quiet={quiet} "
                f"requested_by={args.agent or 'unknown'}"
                + (f" note={args.note}" if args.note else ""))
        append_note("takeover", args.agent or "unknown", text)
        print(f"takeover requested for {args.area} (holder {lease.agent}, "
              f"quiet {quiet}).")
        return 0
    if not args.offline:
        fetch_notes()
    notes = read_notes("takeover")
    open_requests = [n for n in notes if "TAKEOVER REQUEST" in n.text]
    if args.json:
        print(json.dumps([{"agent": n.agent, "text": n.text, "epoch": n.epoch}
                          for n in open_requests], indent=2))
        return 0
    if not open_requests:
        print("no takeover requests.")
        return 0
    for n in open_requests:
        print(f"{iso(n.epoch)} {n.agent}: {n.text}")
    return 0


def cmd_sweep(args: argparse.Namespace) -> int:
    """Delete expired refs, sync issue labels/claims, rebuild the board."""
    fetch_ledger(required=True)
    # The board it rebuilds below is rendered from all three ref families, so
    # refresh the rosters and the notes too: a sweep that read only the leases
    # would regenerate the board *without* its Roster and Handoff-notes sections
    # and silently commit the loss.
    fetch_rosters()
    fetch_notes()
    at = now()
    leases = list_leases()
    expired = [l for l in leases if not l.is_live(at)]

    removed = 0
    for l in expired:
        delete_ref(l.area)
        removed += 1
        if args.gh:
            _sync_issue(l, live=False)
    print(f"swept {removed} expired lease(s); {len(leases) - removed} live remain.")

    # Clear refs left in the old per-issue layout.  They can only exist for an
    # area that has no area ref yet (git forbids `leases/x` and `leases/x/1`
    # together), so this is what unblocks such an area for the new layout.
    legacy = [r for r in list_refs()
              if len(r[len(REF_PREFIX) + 1:].split("/")) == 2]
    for ref in legacy:
        _delete_lease_ref(ref)
    if legacy:
        print(f"cleared {len(legacy)} legacy per-issue ref(s).")

    if args.gh:
        for l in leases:
            if l.is_live(at):
                _sync_issue(l, live=True)
        # A released or closed issue leaves no ref for the loop above to see, so
        # sweep the GitHub side for `status:` labels with no live lease behind
        # them.  This is what keeps the mirror from drifting (issue #222).
        _reconcile_status_labels({l.issue for l in leases if l.is_live(at)})
        # A cross-area block (`status: blocked` + `blocked-by: #<n>`) lifts itself
        # once its blocker(s) close, so a dependent issue becomes claimable again
        # without an agent remembering (issue #326, ADR-0030).
        _clear_resolved_blocks(_open_issue_numbers())

    if not args.no_board:
        cmd_board(argparse.Namespace(offline=True, stdout=False, path=args.board_path))

    if args.commit_board:
        _commit_board(args.board_path or BOARD_PATH)
    return 0


LEASE_COMMENT_MARKER = "<!-- coord-lease -->"


def _lease_comment_body(lease: Lease) -> str:
    return (
        f"{LEASE_COMMENT_MARKER}\n"
        f"**Live lease** — epoch `{lease.epoch}` (`docs/COORDINATION.md`)\n\n"
        f"- holder: `{lease.agent}`\n"
        f"- branch: `{lease.branch or '—'}`\n"
        f"- expires: `{iso(lease.expires)}`\n\n"
        f"_The lease ledger (`refs/coord/leases/*`) is authoritative; this comment "
        f"is a convenience copy for readers of the issue. It is not a claim, and "
        f"editing it does nothing._"
    )


def _sync_issue(lease: Lease, *, live: bool) -> None:
    """Best-effort label + claim-comment sync.  Failures never abort a sweep.

    The comment is posted **once per lease epoch** (not on every sweep), so a
    long-running lease does not generate 30-minute comment spam.
    """
    try:
        if live:
            if lease.state == "claimed":
                gh("issue", "edit", str(lease.issue), "--add-label", "status: claimed")
            elif lease.state == "blocked":
                gh("issue", "edit", str(lease.issue),
                   "--remove-label", "status: claimed", "--add-label", "status: blocked")
            elif lease.state == "needs-review":
                gh("issue", "edit", str(lease.issue),
                   "--remove-label", "status: claimed", "--add-label", "status: needs-review")
            if not _comment_already_posted(lease):
                gh("issue", "comment", str(lease.issue),
                   "--body", _lease_comment_body(lease))
        else:
            gh("issue", "edit", str(lease.issue),
               "--remove-label", "status: claimed", "--remove-label", "status: blocked",
               "--remove-label", "status: needs-review")
    except (CoordError, OSError) as exc:  # pragma: no cover - network path
        print(f"warning: label sync for #{lease.issue} skipped: {exc}", file=sys.stderr)


STATUS_LABELS = ("status: claimed", "status: blocked", "status: needs-review")

# Labels that mark an issue as *not* claimable work.  `next` and the board route
# idle agents to open issues by `focus:` label, so an issue carrying any of these
# must not be offered as a claim target: `status: blocked` waits on another area,
# `question` needs a human decision (§5.2), and `deferred: v2` is out of v1.0.0
# scope (ADR-0024).  An agent steered to one of them wastes a cycle.
NOT_CLAIMABLE_LABELS = frozenset({"status: blocked", "question", "deferred: v2"})


def _reconcile_status_labels(live_issues: set[int]) -> None:
    """Clear a lease-set `status: claimed` from an open issue no live lease backs.

    The labels are a convenience mirror of the ledger, so a *lease-set* label must
    not outlive the lease.  A released lease leaves no ref behind, so reconcile
    from the GitHub side instead: any **open** issue still carrying
    `status: claimed` but absent from ``live_issues`` is stale by definition.

    Scope is deliberately narrow:

    - **open issues only** — a closed issue is historical; its labels are left
      as-is rather than mass-edited on the first sweep;
    - **`status: claimed` only** — the one label *only* a lease ever sets.
      `status: blocked` / `status: needs-review` are also used by the
      human-question (§5.2) and Rule 4 conventions, which have no lease, so
      clearing them here would delete legitimate state.

    Best-effort: a failure never aborts a sweep.
    """
    try:
        proc = gh("issue", "list", "--state", "open", "--limit", "500",
                  "--json", "number,labels", check=False)
    except OSError:  # gh binary absent
        return
    if proc.returncode != 0:
        return
    try:
        rows = json.loads(proc.stdout or "[]")
    except json.JSONDecodeError as exc:  # pragma: no cover
        print(f"warning: status-label reconcile skipped: {exc}", file=sys.stderr)
        return
    for row in rows:
        number = int(row["number"])
        if number in live_issues:
            continue
        names = {l.get("name") for l in row.get("labels", [])}
        if "status: claimed" not in names:
            continue
        try:
            gh("issue", "edit", str(number), "--remove-label", "status: claimed")
            print(f"cleared stale status: claimed on open issue #{number}")
        except (CoordError, OSError) as exc:  # pragma: no cover
            print(f"warning: could not clear label on #{number}: {exc}",
                  file=sys.stderr)


def blocked_by_refs(body: str) -> set[int]:
    """Issue numbers named by `blocked-by:` lines in ``body``.

    The declaration is ``blocked-by: #311`` (several per line allowed:
    ``blocked-by: #311, #312``).  Only the numbers on a `blocked-by:` line are
    read, so prose that happens to mention an issue does not create a block.
    """
    refs: set[int] = set()
    for match in BLOCKED_BY_RE.finditer(body or ""):
        refs.update(int(n) for n in ISSUE_REF_RE.findall(match.group("refs")))
    return refs


def _open_issue_numbers() -> Optional[set[int]]:
    """The set of open issue numbers, or ``None`` if GitHub could not be read.

    ``None`` (not an empty set) is the "unknown" answer: a sweep must never treat
    a failed read as "everything is closed" and clear a live block.
    """
    try:
        proc = gh("issue", "list", "--state", "open", "--limit", "500",
                  "--json", "number", check=False)
    except OSError:  # gh binary absent
        return None
    if proc.returncode != 0:
        return None
    try:
        rows = json.loads(proc.stdout or "[]")
    except json.JSONDecodeError:
        return None
    return {int(row["number"]) for row in rows}


def _clear_resolved_blocks(open_numbers: Optional[set[int]]) -> None:
    """Clear `status: blocked` from issues whose `blocked-by:` blockers all closed.

    A cross-area block is declared by hand as `status: blocked` plus a
    machine-readable `blocked-by: #<n>` in the body (docs/COORDINATION.md §3,
    ADR-0030).  Nothing used to clear it when the blocker landed, so the issue
    stayed unclaimable forever and a *fresh* agent was never routed to it —
    `next` skips `status: blocked` by design (ADR-0026, issue #326).

    Scope is deliberately narrow, mirroring `_reconcile_status_labels`:

    - **`status: blocked` with at least one `blocked-by:` ref only** — a human
      question (§5.2) also carries `status: blocked` but has no `blocked-by:`
      line, so it is never touched;
    - **every** referenced issue must be *known closed* — ``open_numbers`` is the
      open set, and ``None`` (an unreadable GitHub) clears nothing.

    Best-effort: a failure never aborts a sweep.
    """
    if open_numbers is None:
        return
    try:
        proc = gh("issue", "list", "--state", "open", "--limit", "500",
                  "--json", "number,body,labels", check=False)
    except OSError:  # gh binary absent
        return
    if proc.returncode != 0:
        return
    try:
        rows = json.loads(proc.stdout or "[]")
    except json.JSONDecodeError as exc:  # pragma: no cover
        print(f"warning: blocked-by reconcile skipped: {exc}", file=sys.stderr)
        return
    for row in rows:
        number = int(row["number"])
        names = {l.get("name") for l in row.get("labels", [])}
        if "status: blocked" not in names:
            continue
        refs = blocked_by_refs(row.get("body") or "")
        if not refs or refs & open_numbers:
            continue
        try:
            gh("issue", "edit", str(number), "--remove-label", "status: blocked")
            print(f"cleared resolved status: blocked on open issue #{number} "
                  f"(blockers {sorted(refs)} closed)")
        except (CoordError, OSError) as exc:  # pragma: no cover
            print(f"warning: could not clear label on #{number}: {exc}",
                  file=sys.stderr)


def _comment_already_posted(lease: Lease) -> bool:
    """True if this lease's epoch already has a claim comment on the issue."""
    proc = gh("issue", "view", str(lease.issue), "--json", "comments", check=False)
    if proc.returncode != 0:
        return False
    try:
        comments = json.loads(proc.stdout).get("comments", [])
    except json.JSONDecodeError:
        return False
    needle = f"epoch `{lease.epoch}`"
    return any(LEASE_COMMENT_MARKER in c.get("body", "") and needle in c.get("body", "")
               for c in comments)


def _board_identity_args() -> list[str]:
    """``-c`` flags supplying an author when the environment has none.

    A fresh CI checkout has no ``user.name``/``user.email``, so ``git commit``
    fails with "Author identity unknown" - and because the old code ignored the
    result, the board was silently never committed while the push (a no-op
    against an unchanged ``main``) still reported success (issue #381).
    """
    email = git("config", "user.email", check=False)
    if email.returncode == 0 and email.stdout.strip():
        return []
    return [
        "-c", "user.name=github-actions[bot]",
        "-c", "user.email=41898282+github-actions[bot]@users.noreply.github.com",
    ]


def _commit_board(path: str) -> None:
    """Commit + push the regenerated board (used by the scheduled workflow).

    The board is generated from the ledger and published on ``main``. A plain
    ``push HEAD:main`` from the run's checkout is a non-fast-forward whenever a
    PR merged while the sweep ran, so it is retried on a freshly fetched
    ``main``. It is never forced: a concurrent merge is real work and must not
    be discarded. The commit and push results are both checked, so the sweep
    fails loudly instead of printing success while the board stays stale
    (issue #381, ADR-0033).
    """
    if not os.path.exists(path):
        return
    git("add", path, check=False)
    diff = git("diff", "--cached", "--quiet", check=False)
    if diff.returncode == 0:
        print("board unchanged; nothing to commit")
        return

    identity = _board_identity_args()
    commit = git(*identity, "commit", "-m", BOARD_COMMIT_MSG, check=False)
    if commit.returncode != 0:
        detail = (commit.stderr or commit.stdout or "").strip()
        raise CoordError(f"could not commit {path}: {detail}")

    last = None
    for _ in range(BOARD_PUSH_ATTEMPTS):
        git("fetch", "--prune", "--force", "origin",
            f"+refs/heads/{BOARD_BRANCH}:refs/remotes/origin/{BOARD_BRANCH}",
            check=False)
        # Re-apply the board on the current tip so the push is a fast-forward.
        rebase = git(*identity, "rebase", f"origin/{BOARD_BRANCH}", check=False)
        if rebase.returncode != 0:
            git("rebase", "--abort", check=False)
            last = (rebase.stderr or rebase.stdout or "").strip()
            continue
        push = git("push", "origin",
                   f"HEAD:refs/heads/{BOARD_BRANCH}", check=False)
        if push.returncode == 0:
            print("board committed and pushed")
            return
        last = (push.stderr or push.stdout or "").strip()

    hint = _push_hint(last or "")
    detail = hint or last or "unknown error"
    raise CoordError(
        f"could not publish {path} after {BOARD_PUSH_ATTEMPTS} attempts "
        f"(the board on {BOARD_BRANCH} may be stale): {detail}"
    )


# --------------------------------------------------------------------------- #
# Migration from the legacy comment protocol
# --------------------------------------------------------------------------- #

def cmd_migrate(args: argparse.Namespace) -> int:
    """One-off import of legacy CLAIM:/LEASE: comments into the ledger.

    Reads the legacy hub issue (and any issues listed) via ``gh``, parses the
    last claim per issue, and prints the ``coord claim`` invocations that
    reproduce that state as leases.  ``--apply`` performs them.  Closed issues and
    claims already older than the TTL are skipped: only *live* legacy claims need
    migrating.  See docs/COORDINATION_MIGRATION.md.
    """
    if not args.issues:
        raise CoordError("migrate needs at least one issue number (e.g. the hub, 38)")
    fetch_ledger(required=True)
    at = now()
    commands: list[str] = []
    for issue in args.issues:
        proc = gh("issue", "view", str(issue), "--json",
                  "comments,state,number,title", check=False)
        if proc.returncode != 0:
            print(f"warning: cannot read #{issue}; skipping", file=sys.stderr)
            continue
        try:
            data = json.loads(proc.stdout)
        except json.JSONDecodeError:
            continue
        if data.get("state") != "OPEN":
            print(f"#{issue}: closed - nothing to migrate")
            continue
        comments = data.get("comments", [])
        latest: Optional[dict] = None
        for c in comments:
            body = c.get("body", "")
            m = LEGACY_CLAIM_RE.search(body) or LEGACY_TAKEOVER_RE.search(body)
            if m:
                latest = {
                    "agent": m.group("agent").strip(),
                    "area": m.group("area").strip().replace("focus:", "").strip(),
                    "branch": "",
                    "ts": c.get("createdAt", ""),
                }
            lm = LEGACY_LEASE_RE.search(body)
            if lm and latest is not None:
                latest["branch"] = lm.group("branch").strip()
        if not latest:
            print(f"#{issue}: no legacy claim")
            continue
        if latest["area"] not in AREAS:
            print(f"#{issue}: legacy claim has unknown area '{latest['area']}' - skipped")
            continue
        # Only a *live* legacy claim needs a lease; an expired one is already
        # reclaimable, so importing it would just recreate a dead claim.
        age = _comment_age_seconds(latest["ts"], at)
        if age is not None and age > MAX_TTL:
            print(f"#{issue}: legacy claim by {latest['agent']} is expired "
                  f"({human_delta(age)} old) - left free")
            continue
        cmds = [
            "scripts/coord", "claim",
            "--area", latest["area"], "--issue", str(issue),
            "--agent", latest["agent"],
            "--branch", latest["branch"] or f"migrated/{latest['area']}-{issue}",
            "--note", f"migrated from legacy CLAIM comment ({latest['ts']})",
            "--takeover",
        ]
        line = " ".join(shlex.quote(c) for c in cmds)
        commands.append(line)
        print(f"#{issue}: live legacy claim by {latest['agent']} in '{latest['area']}'")

    if not commands:
        print("no live legacy claims found; nothing to migrate.")
        return 0
    # The area is the lock, so two live legacy claims in the same area cannot
    # both become leases; the second would lose the CAS.  Say so up front.
    areas = [shlex.split(c)[shlex.split(c).index("--area") + 1] for c in commands]
    dupes = {a for a in areas if areas.count(a) > 1}
    if dupes:
        print(f"note: multiple live legacy claims share area(s) "
              f"{', '.join(sorted(dupes))}; only the first will take the lease - "
              f"the others need their own area or must wait for expiry.")
    print("\nRun these to import the legacy claims as leases:\n")
    for line in commands:
        print("  " + line)
    if args.apply:
        print("\n--apply: executing...")
        for line in commands:
            parts = shlex.split(line)
            rc = main(parts[1:])
            if rc != 0:
                print(f"  (failed: {line})", file=sys.stderr)
    return 0


def _comment_age_seconds(ts: str, at: int) -> Optional[int]:
    """Age in seconds of an ISO-8601 ``...Z`` timestamp, or None if unparseable."""
    if not ts:
        return None
    try:
        parsed = time.strptime(ts, "%Y-%m-%dT%H:%M:%SZ")
    except ValueError:
        return None
    return at - int(time.mktime(parsed) + time.timezone)


# --------------------------------------------------------------------------- #
# CLI
# --------------------------------------------------------------------------- #

def _add_common(p: argparse.ArgumentParser) -> None:
    p.add_argument("--agent", required=True,
                   help="your agent name, '<role>-<n>-<host>' "
                        "(e.g. ta-1-kastenbrot, sm-1-gnampf); a legacy model "
                        "string is still accepted by the ledger")


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="coord",
        description="git-native task lease ledger for a fleet of parallel agents.",
    )
    sub = parser.add_subparsers(dest="command", required=True)

    p = sub.add_parser("claim", help="take a lease on an area/issue")
    _add_common(p)
    p.add_argument("--area", required=True, choices=AREAS)
    p.add_argument("--issue", required=True, type=int)
    p.add_argument("--branch", default="")
    p.add_argument("--ttl", type=parse_duration, default=DEFAULT_TTL)
    p.add_argument("--note", default="")
    p.add_argument("--takeover", action="store_true",
                   help="take an expired or someone else's lease (announced); "
                        "also clears a pre-fix client's legacy ref if present")
    p.set_defaults(func=cmd_claim)

    p = sub.add_parser("renew", help="extend a lease you hold")
    _add_common(p)
    p.add_argument("--area", required=True, choices=AREAS)
    p.add_argument("--issue", required=True, type=int)
    p.add_argument("--branch", default=None,
                   help="the branch your lease records (default: the current "
                        "branch); guards against a same-named peer's lease")
    p.add_argument("--ttl", type=parse_duration, default=None)
    p.add_argument("--state", choices=("claimed", "blocked", "needs-review"), default=None)
    p.add_argument("--note", default=None)
    p.add_argument("--force", action="store_true")
    p.set_defaults(func=cmd_renew)

    p = sub.add_parser("release", help="give up a lease early")
    _add_common(p)
    p.add_argument("--area", required=True, choices=AREAS)
    p.add_argument("--issue", required=True, type=int)
    p.add_argument("--branch", default=None,
                   help="the branch your lease records (default: the current "
                        "branch); guards against a same-named peer's lease")
    p.add_argument("--force", action="store_true")
    p.set_defaults(func=cmd_release)

    p = sub.add_parser("status", help="print the ledger")
    p.add_argument("--json", action="store_true")
    p.add_argument("--offline", action="store_true", help="do not fetch from origin")
    p.set_defaults(func=cmd_status)

    p = sub.add_parser("check", help="assert no live lease collisions (CI gate)")
    p.add_argument("--offline", action="store_true")
    p.set_defaults(func=cmd_check)

    p = sub.add_parser("next", help="print the next action for an idle agent (never empty)")
    _add_common(p)
    p.add_argument("--offline", action="store_true")
    p.set_defaults(func=cmd_next)

    p = sub.add_parser("board", help="render the generated coordination board")
    p.add_argument("--path", default=None)
    p.add_argument("--stdout", action="store_true")
    p.add_argument("--offline", action="store_true")
    p.set_defaults(func=cmd_board)

    p = sub.add_parser("note", help="append a cross-cycle note to a topic (survives release)")
    _add_common(p)
    p.add_argument("--area", required=True, choices=AREAS + CHANNELS,
                   help="a focus area, or a channel: " + ", ".join(CHANNELS))
    p.add_argument("--text", required=True)
    p.set_defaults(func=cmd_note)

    p = sub.add_parser("notes", help="print notes for a topic, or every topic")
    p.add_argument("--area", choices=AREAS + CHANNELS, default=None)
    p.add_argument("--json", action="store_true")
    p.add_argument("--offline", action="store_true")
    p.set_defaults(func=cmd_notes)

    p = sub.add_parser("msg", help="send a direct message to one named agent")
    p.add_argument("--to", required=True, metavar="AGENT",
                   help="the recipient's agent name (<role>-<n>-<host>)")
    p.add_argument("--agent", required=True,
                   help="your own agent name (who the message is from)")
    p.add_argument("--text", required=True, help="the message")
    p.set_defaults(func=cmd_msg)

    p = sub.add_parser("inbox", help="read the messages addressed to one agent")
    p.add_argument("--agent", required=True, help="your own agent name")
    p.add_argument("--json", action="store_true")
    p.add_argument("--offline", action="store_true")
    p.set_defaults(func=cmd_inbox)

    p = sub.add_parser("agent", help="register / reserve / retire / list named agents on a host roster")
    action = p.add_mutually_exclusive_group()
    action.add_argument("--register", action="store_true")
    action.add_argument("--reserve", action="store_true",
                        help="hold a name (status 'reserved') without starting an agent")
    p.add_argument("--list", action="store_true",
                   help="list the rosters (the default with no action flag)")
    p.add_argument("--retire", default="", metavar="NAME")
    p.add_argument("--host", default="",
                   help="the computer; defaults to $COORD_HOST, else the hostname")
    p.add_argument("--role", default="", help="a focus-area code, or 'sm' / 'po'")
    p.add_argument("--model", default="", help="the LLM model behind this agent")
    p.add_argument("--name", default="", help="pin an exact agent name (else auto-allocated)")
    p.add_argument("--succeeded-by", default="", metavar="NAME")
    p.add_argument("--json", action="store_true")
    p.set_defaults(func=cmd_agent)

    p = sub.add_parser("takeover", help="request, or list, a takeover of a quiet holder")
    p.add_argument("--request", action="store_true")
    p.add_argument("--area", default=None, choices=AREAS)
    p.add_argument("--agent", default="", help="who is asking")
    p.add_argument("--note", default="")
    p.add_argument("--json", action="store_true")
    p.add_argument("--offline", action="store_true")
    p.set_defaults(func=cmd_takeover)

    p = sub.add_parser("sweep", help="delete expired refs, sync labels, rebuild board")
    p.add_argument("--gh", action="store_true", help="also sync issue labels/comments (needs gh)")
    p.add_argument("--no-board", action="store_true")
    p.add_argument("--board-path", default=None)
    p.add_argument("--commit-board", action="store_true")
    p.set_defaults(func=cmd_sweep)

    p = sub.add_parser("migrate", help="import legacy CLAIM:/LEASE: comments (one-off)")
    p.add_argument("--issues", nargs="+", type=int)
    p.add_argument("--apply", action="store_true")
    p.set_defaults(func=cmd_migrate)

    return parser


def main(argv: Optional[Iterable[str]] = None) -> int:
    parser = build_parser()
    args = parser.parse_args(list(argv) if argv is not None else None)
    try:
        return args.func(args)
    except CoordError as exc:
        print(f"coord: {exc}", file=sys.stderr)
        return 2


if __name__ == "__main__":
    raise SystemExit(main())
